<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"] - ERA Company</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.1/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/company.css" asp-append-version="true">
</head>

<body class="theme-dark">

    <!-- ================= NAVBAR ================= -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">

            <a class="navbar-brand"
               asp-area="Company"
               asp-controller="Home"
               asp-action="Index">

                <i class="bi bi-mortarboard-fill"></i>
                ERA Company

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">

                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link text-uppercase"
                           asp-area="Company"
                           asp-controller="Instractor"
                           asp-action="Index">
                            Instructor
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-uppercase"
                           asp-area="Company"
                           asp-controller="Category"
                           asp-action="Index">
                            Category
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-uppercase"
                           asp-area="Company"
                           asp-controller="Employee"
                           asp-action="Index">
                            Employee
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase"
                           asp-area="Company"
                           asp-controller="Certificates"
                           asp-action="Index">
                            Certificates
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase"
                               asp-area="Customer"
                               asp-controller="Home"
                               asp-action="Index">
                            Home Page
                        </a>
                    </li>
                </ul>

            </div>

        </div>
    </nav>


    <!-- ================= MAIN ================= -->
    <main class="container my-4">
        @RenderBody()
    </main>


    


    <!-- ================= SCRIPTS ================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/company.js" asp-append-version="true"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    @await RenderSectionAsync("scripts", required: false)

</body>
</html>
