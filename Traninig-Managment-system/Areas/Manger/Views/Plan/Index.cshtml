@model IEnumerable<ManagerPlanVm>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<header class="manager-page-hero">
    <div>
        <span class="manager-kicker">Commercial Setup</span>
        <h1>Plans & Features</h1>
        <p>Edit pricing plans, add or remove feature lines, and keep plan packaging aligned with the growth strategy.</p>
    </div>

    <div class="manager-hero-actions">
        <a asp-action="Create" class="btn btn--primary">Create Plan</a>
    </div>
</header>

<section class="manager-plan-grid">
    @foreach (var plan in Model)
    {
        <article class="manager-plan-card expanded">
            <div class="manager-plan-top">
                <span class="manager-plan-type">@plan.Type</span>
                <span class="manager-plan-status @(plan.IsActive ? "active" : "inactive")">
                    @(plan.IsActive ? "Active" : "Inactive")
                </span>
            </div>

            <h2>@plan.Name</h2>
            <p class="manager-plan-price">@plan.Price.ToString("N0") EGP</p>

            <div class="manager-plan-metrics">
                <span>@plan.MaxEmployees employees</span>
                <span>@plan.MaxCourses courses</span>
                <span>@plan.DurationInDays days</span>
                <span>@plan.CompanyCount company(s)</span>
            </div>

            <div class="manager-feature-list">
                @foreach (var feature in plan.Features)
                {
                    <span class="@(feature.IsHighlighted ? "highlighted" : string.Empty)">
                        @feature.Name
                    </span>
                }
            </div>

            <div class="manager-card-actions">
                <a asp-action="Details" asp-route-id="@plan.Id" class="btn btn--ghost">Details</a>
                <a asp-action="Edit" asp-route-id="@plan.Id" class="btn btn--secondary">Edit</a>
                <form asp-action="Delete" method="post" class="m-0" onsubmit="return confirm('Delete this plan?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@plan.Id" />
                    <button type="submit" class="btn btn--danger">Delete</button>
                </form>
            </div>
        </article>
    }
</section>
