@model ManagerPlanVm

<div class="manager-form-surface">
    <form method="post" class="manager-form-grid">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="manager-form-field">
            <label asp-for="Name">Plan Name</label>
            <input asp-for="Name" class="form-control" placeholder="Premium Growth" />
        </div>

        <div class="manager-form-field">
            <label asp-for="Type">Plan Type</label>
            <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<Plan.PlanType>()"></select>
        </div>

        <div class="manager-form-field">
            <label asp-for="Price">Price</label>
            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
        </div>

        <div class="manager-form-field">
            <label asp-for="DurationInDays">Duration In Days</label>
            <input asp-for="DurationInDays" class="form-control" type="number" min="1" />
        </div>

        <div class="manager-form-field">
            <label asp-for="MaxEmployees">Max Employees</label>
            <input asp-for="MaxEmployees" class="form-control" type="number" min="1" />
        </div>

        <div class="manager-form-field">
            <label asp-for="MaxCourses">Max Courses</label>
            <input asp-for="MaxCourses" class="form-control" type="number" min="1" />
        </div>

        <div class="manager-form-field full">
            <label asp-for="FeaturesText">Features</label>
            <textarea asp-for="FeaturesText" class="form-control" rows="10" placeholder="One feature per line&#10;Feature title | optional description"></textarea>
            <small>Write one feature per line. You can optionally add a description after `|`.</small>
        </div>

        <div class="manager-form-toggle">
            <input asp-for="IsActive" type="checkbox" />
            <label asp-for="IsActive">Plan Active</label>
        </div>

        <div class="manager-card-actions full">
            <a asp-action="Index" class="btn btn--ghost">Cancel</a>
            <button type="submit" class="btn btn--primary">Save Plan</button>
        </div>
    </form>
</div>
