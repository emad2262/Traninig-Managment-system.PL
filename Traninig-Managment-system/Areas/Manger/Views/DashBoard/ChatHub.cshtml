@{
    ViewData["Title"] = "Chat Hub";
}

<header class="manager-page-hero">
    <div>
        <span class="manager-kicker">Future Module</span>
        <h1>Live Chat Hub</h1>
        <p>This page is intentionally prepared as the future communication center between companies and the manager team.</p>
    </div>
</header>

<section class="manager-two-column-grid">
    <article class="manager-surface">
        <div class="manager-surface-head">
            <div>
                <span class="manager-kicker">Now</span>
                <h2>What Is Ready</h2>
            </div>
        </div>
        <div class="manager-roadmap">
            <div class="manager-roadmap-item done">
                <strong>Company Directory</strong>
                <p>Companies are already visible with subscription state and quick reminder actions.</p>
            </div>
            <div class="manager-roadmap-item done">
                <strong>Notification Log</strong>
                <p>Manager notifications are stored per company and can be reviewed in the company details view.</p>
            </div>
        </div>
    </article>

    <article class="manager-surface">
        <div class="manager-surface-head">
            <div>
                <span class="manager-kicker">Next</span>
                <h2>Planned Chat Stack</h2>
            </div>
        </div>
        <div class="manager-roadmap">
            <div class="manager-roadmap-item current">
                <strong>Real-time Threading</strong>
                <p>Add SignalR rooms per company so the manager and company admins can exchange live messages.</p>
            </div>
            <div class="manager-roadmap-item">
                <strong>Unread Counters</strong>
                <p>Show pending messages and escalation badges directly inside the manager dashboard.</p>
            </div>
            <div class="manager-roadmap-item">
                <strong>Renewal Automation</strong>
                <p>Convert reminders into guided conversations when subscriptions are close to expiring.</p>
            </div>
        </div>
    </article>
</section>
