@model ManagerDashboardVm
@using System.Text.Json

@{
    ViewData["Title"] = "Manager Dashboard";

    var companyLabelsJson = JsonSerializer.Serialize(Model.CompanyGrowth.Select(p => p.Label));
    var companyValuesJson = JsonSerializer.Serialize(Model.CompanyGrowth.Select(p => p.Value));
    var employeeLabelsJson = JsonSerializer.Serialize(Model.EmployeeGrowth.Select(p => p.Label));
    var employeeValuesJson = JsonSerializer.Serialize(Model.EmployeeGrowth.Select(p => p.Value));
}

<header class="manager-page-hero">
    <div>
        <span class="manager-kicker">Platform Control</span>
        <h1>Manager Control Center</h1>
        <p>Track platform growth, review expiring subscriptions, shape plan features, and prepare the communication layer for future live chat with companies.</p>
    </div>

    <div class="manager-hero-actions">
        <a asp-area="Manger" asp-controller="Plan" asp-action="Index" class="btn btn--primary">Manage Plans</a>
        <a asp-area="Manger" asp-controller="Companies" asp-action="Index" class="btn btn--secondary">Open Companies</a>
    </div>
</header>

<section class="manager-kpi-grid">
    <article class="manager-kpi-card">
        <span>Total Companies</span>
        <strong>@Model.TotalCompanies</strong>
    </article>
    <article class="manager-kpi-card">
        <span>Active Companies</span>
        <strong>@Model.ActiveCompanies</strong>
    </article>
    <article class="manager-kpi-card">
        <span>Total Employees</span>
        <strong>@Model.TotalEmployees</strong>
    </article>
    <article class="manager-kpi-card">
        <span>Plans</span>
        <strong>@Model.TotalPlans</strong>
    </article>
    <article class="manager-kpi-card">
        <span>Notifications Sent</span>
        <strong>@Model.TotalNotifications</strong>
    </article>
    <article class="manager-kpi-card danger">
        <span>Expiring In 30 Days</span>
        <strong>@Model.ExpiringSoonCount</strong>
    </article>
</section>

<section class="manager-two-column-grid">
    <article class="manager-surface">
        <div class="manager-surface-head">
            <div>
                <span class="manager-kicker">Growth</span>
                <h2>New Companies</h2>
            </div>
        </div>
        <canvas id="companiesGrowthChart" height="180"></canvas>
    </article>

    <article class="manager-surface">
        <div class="manager-surface-head">
            <div>
                <span class="manager-kicker">People</span>
                <h2>New Employees</h2>
            </div>
        </div>
        <canvas id="employeesGrowthChart" height="180"></canvas>
    </article>
</section>

<section class="manager-three-column-grid">
    <article class="manager-surface">
        <div class="manager-surface-head">
            <div>
                <span class="manager-kicker">Renewals</span>
                <h2>Expiring Companies</h2>
            </div>
            <a asp-area="Manger" asp-controller="Companies" asp-action="Index">See all</a>
        </div>

        @if (!Model.ExpiringCompanies.Any())
        {
            <div class="manager-empty-box">
                <p>No urgent renewals right now.</p>
            </div>
        }
        else
        {
            <div class="manager-company-stack">
                @foreach (var company in Model.ExpiringCompanies)
                {
                    <a asp-area="Manger" asp-controller="Companies" asp-action="Details" asp-route-id="@company.Id" class="manager-mini-company">
                        <div>
                            <strong>@company.Name</strong>
                            <span>@company.PlanName</span>
                        </div>
                        <div class="manager-mini-company-meta">
                            <span>@company.DaysToRenewal day(s)</span>
                        </div>
                    </a>
                }
            </div>
        }
    </article>

    <article class="manager-surface">
        <div class="manager-surface-head">
            <div>
                <span class="manager-kicker">Acquisition</span>
                <h2>Recent Companies</h2>
            </div>
            <a asp-area="Manger" asp-controller="Companies" asp-action="Index">Directory</a>
        </div>

        @if (!Model.RecentCompanies.Any())
        {
            <div class="manager-empty-box">
                <p>No recent companies available.</p>
            </div>
        }
        else
        {
            <div class="manager-company-stack">
                @foreach (var company in Model.RecentCompanies)
                {
                    <a asp-area="Manger" asp-controller="Companies" asp-action="Details" asp-route-id="@company.Id" class="manager-mini-company">
                        <div>
                            <strong>@company.Name</strong>
                            <span>@company.SubscriptionStart.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="manager-mini-company-meta">
                            <span>@company.EmployeeCount employee(s)</span>
                        </div>
                    </a>
                }
            </div>
        }
    </article>

    <article class="manager-surface">
        <div class="manager-surface-head">
            <div>
                <span class="manager-kicker">Roadmap</span>
                <h2>Live Chat Hub</h2>
            </div>
            <a asp-area="Manger" asp-controller="DashBoard" asp-action="ChatHub">Preview</a>
        </div>

        <div class="manager-roadmap">
            <div class="manager-roadmap-item done">
                <strong>Notification Center</strong>
                <p>Managers can now push renewal and feature notices to companies.</p>
            </div>
            <div class="manager-roadmap-item current">
                <strong>Company Communication Layer</strong>
                <p>Prepared as the natural home for future live chat and real-time renewals follow-up.</p>
            </div>
            <div class="manager-roadmap-item">
                <strong>Live Chat</strong>
                <p>Next step: attach SignalR or a conversation store for manager-company messaging.</p>
            </div>
        </div>
    </article>
</section>

<section class="manager-surface">
    <div class="manager-surface-head">
        <div>
            <span class="manager-kicker">Commercial Engine</span>
            <h2>Plans Snapshot</h2>
        </div>
        <a asp-area="Manger" asp-controller="Plan" asp-action="Index">Open all plans</a>
    </div>

    <div class="manager-plan-grid">
        @foreach (var plan in Model.Plans)
        {
            <article class="manager-plan-card">
                <div class="manager-plan-top">
                    <span class="manager-plan-type">@plan.Type</span>
                    <span class="manager-plan-status @(plan.IsActive ? "active" : "inactive")">
                        @(plan.IsActive ? "Active" : "Inactive")
                    </span>
                </div>

                <h3>@plan.Name</h3>
                <p>@plan.Price.ToString("N0") EGP</p>

                <div class="manager-plan-metrics">
                    <span>@plan.MaxEmployees employees</span>
                    <span>@plan.MaxCourses courses</span>
                    <span>@plan.DurationInDays days</span>
                    <span>@plan.CompanyCount company(s)</span>
                </div>

                <div class="manager-feature-list">
                    @foreach (var feature in plan.Features.Take(4))
                    {
                        <span>@feature.Name</span>
                    }
                </div>
            </article>
        }
    </div>
</section>

