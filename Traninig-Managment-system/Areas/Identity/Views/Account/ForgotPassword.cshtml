@model ForgotPasswordVm

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-container">
    <div class="auth-form-section" style="margin-inline:auto;">
        <div class="auth-form-wrapper">
            <div class="form-header">
                <h2>Reset Password</h2>
                <p>Enter your email and we'll send a reset link if the account exists.</p>
            </div>

            <div asp-validation-summary="All" class="validation-summary"></div>

            <form method="post" asp-action="ForgotPassword" class="auth-form">
                <div class="form-group">
                    <label asp-for="Email">Email Address</label>
                    <input type="email" class="form-input" asp-for="Email" placeholder="you@company.com">
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <button type="submit" class="btn-submit">Send Reset Link</button>
            </form>

            <div class="form-footer">
                <p><a asp-action="Login">Back to login</a></p>
            </div>
        </div>
    </div>
</div>
