@model ResetPasswordVm

@{
    ViewData["Title"] = "Reset Password";
}

<div class="auth-container">
    <div class="auth-form-section" style="margin-inline:auto;">
        <div class="auth-form-wrapper">
            <div class="form-header">
                <h2>Choose a new password</h2>
                <p>Use a strong password that you do not use elsewhere.</p>
            </div>

            <div asp-validation-summary="All" class="validation-summary"></div>

            <form method="post" asp-action="ResetPassword" class="auth-form">
                <input asp-for="Email" type="hidden" />
                <input asp-for="Token" type="hidden" />

                <div class="form-group">
                    <label asp-for="Password">New Password</label>
                    <input type="password" class="form-input" asp-for="Password">
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword">Confirm Password</label>
                    <input type="password" class="form-input" asp-for="ConfirmPassword">
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>

                <button type="submit" class="btn-submit">Reset Password</button>
            </form>
        </div>
    </div>
</div>
