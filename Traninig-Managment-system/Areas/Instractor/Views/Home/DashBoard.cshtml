@model InstructorDashboardVm

@{
    ViewData["Title"] = "Instructor Overview";
}

<section class="instructor-hero">
    <div>
        <span class="instructor-kicker">Instructor Overview</span>
        <h1>Welcome back, @Model.InstructorName</h1>
        <p>تابع الكورسات، الدروس، الموظفين، الامتحانات، ونسب الإنجاز من مكان واحد.</p>
    </div>
    <a asp-area="Instractor" asp-controller="InstructorProgress" asp-action="Index" class="btn btn-instructor-light">
        <i class="fas fa-users-line"></i>
        <span>متابعة الموظفين</span>
    </a>
</section>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success instructor-alert">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger instructor-alert">@TempData["ErrorMessage"]</div>
}

<section class="instructor-stat-grid">
    <div class="instructor-stat-card">
        <span>الكورسات</span>
        <strong>@Model.TotalCourses</strong>
    </div>
    <div class="instructor-stat-card">
        <span>الشباتر</span>
        <strong>@Model.TotalChapters</strong>
    </div>
    <div class="instructor-stat-card">
        <span>الدروس</span>
        <strong>@Model.TotalLessons</strong>
    </div>
    <div class="instructor-stat-card">
        <span>الموظفين</span>
        <strong>@Model.TotalAssignedEmployees</strong>
    </div>
    <div class="instructor-stat-card">
        <span>متوسط الإنجاز</span>
        <strong>@Model.AverageProgress%</strong>
    </div>
    <div class="instructor-stat-card">
        <span>الامتحانات</span>
        <strong>@Model.TotalExams</strong>
    </div>
</section>

<section class="instructor-panel">
    <div class="instructor-panel-header">
        <div>
            <span class="instructor-kicker">Courses Map</span>
            <h2>الكورسات حسب الأقسام</h2>
        </div>
    </div>

    @if (!Model.Categories.Any())
    {
        <div class="instructor-empty">
            <i class="fas fa-book-open"></i>
            <h3>لا توجد كورسات مربوطة بحسابك حتى الآن</h3>
            <p>اطلب من مسؤول الشركة ربط الكورسات بحساب المدرب الخاص بك.</p>
        </div>
    }
    else
    {
        <div class="instructor-category-stack">
            @foreach (var category in Model.Categories)
            {
                <article class="instructor-category-card">
                    <div class="instructor-category-header">
                        <h3>@category.CategoryName</h3>
                        <span>@category.Courses.Count كورس</span>
                    </div>

                    <div class="instructor-course-grid">
                        @foreach (var course in category.Courses)
                        {
                            <div class="instructor-course-card">
                                <div class="course-card-top">
                                    <span class="status-pill @(course.IsPublished ? "published" : "draft")">
                                        @(course.IsPublished ? "منشور" : "مسودة")
                                    </span>
                                    <span>@course.DurationInHours ساعة</span>
                                </div>
                                <h4>@course.Title</h4>
                                <p>@course.Description</p>
                                <div class="course-card-metrics">
                                    <span><i class="fas fa-layer-group"></i>@course.ChapterCount شابتر</span>
                                    <span><i class="fas fa-play"></i>@course.LessonCount درس</span>
                                    <span><i class="fas fa-users"></i>@course.AssignedEmployees موظف</span>
                                    <span><i class="fas fa-clipboard-check"></i>@course.ExamCount امتحان</span>
                                </div>
                                <div class="progress-line">
                                    <span style="width:@course.AverageProgress%"></span>
                                </div>
                                <div class="course-card-actions">
                                    <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-instructor-primary btn-sm">
                                        <i class="fas fa-eye"></i> فتح الكورس
                                    </a>
                                    <a asp-area="Instractor" asp-controller="InstructorLessons" asp-action="CreateLessons" asp-route-courseId="@course.Id" class="btn btn-instructor-light btn-sm">
                                        <i class="fas fa-plus"></i> درس
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

<section class="instructor-panel">
    <div class="instructor-panel-header">
        <div>
            <span class="instructor-kicker">Recent Progress</span>
            <h2>آخر نشاط للموظفين</h2>
        </div>
        <a asp-area="Instractor" asp-controller="InstructorProgress" asp-action="Index" class="btn btn-instructor-light btn-sm">عرض الكل</a>
    </div>

    <div class="responsive-table">
        <table class="instructor-table">
            <thead>
                <tr>
                    <th>الموظف</th>
                    <th>الكورس</th>
                    <th>الإنجاز</th>
                    <th>الدروس</th>
                    <th>الحالة</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.RecentProgress)
                {
                    <tr>
                        <td>
                            <strong>@row.Name</strong>
                            <small>@row.Email</small>
                        </td>
                        <td>@row.CourseName</td>
                        <td>
                            <div class="table-progress">
                                <span style="width:@row.Progress%"></span>
                            </div>
                            <small>@row.Progress%</small>
                        </td>
                        <td>@row.CompletedLessons / @row.TotalLessons</td>
                        <td><span class="status-pill">@row.Status</span></td>
                        <td>
                            <a asp-area="Instractor" asp-controller="InstructorProgress" asp-action="Details" asp-route-employeeId="@row.EmployeeId" class="btn btn-instructor-light btn-sm">تفاصيل</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
