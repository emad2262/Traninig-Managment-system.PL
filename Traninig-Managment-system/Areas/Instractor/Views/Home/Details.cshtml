@model InstructorCourseDetailsVm

@{
    ViewData["Title"] = Model.Title;
}

<nav class="instructor-breadcrumb">
    <a asp-action="DashBoard">Overview</a>
    <i class="fas fa-chevron-right"></i>
    <span>@Model.Title</span>
</nav>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success instructor-alert">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger instructor-alert">@TempData["ErrorMessage"]</div>
}

<section class="course-overview-hero">
    <div>
        <span class="instructor-kicker">@Model.CategoryName</span>
        <h1>@Model.Title</h1>
        <p>@Model.Description</p>
        <div class="course-hero-actions">
            <a asp-area="Instractor" asp-controller="InstructorChapters" asp-action="Create" asp-route-courseId="@Model.Id" class="btn btn-instructor-primary">
                <i class="fas fa-layer-group"></i> إضافة شابتر
            </a>
            <a asp-area="Instractor" asp-controller="InstructorLessons" asp-action="CreateLessons" asp-route-courseId="@Model.Id" class="btn btn-instructor-light">
                <i class="fas fa-plus"></i> إضافة درس
            </a>
            <a asp-area="Instractor" asp-controller="InstructorProgress" asp-action="Index" asp-route-courseId="@Model.Id" class="btn btn-instructor-light">
                <i class="fas fa-users"></i> الموظفين
            </a>
        </div>
    </div>
    <div class="course-progress-orb">
        <strong>@Model.AverageProgress%</strong>
        <span>متوسط الإنجاز</span>
    </div>
</section>

<section class="instructor-stat-grid">
    <div class="instructor-stat-card"><span>الشباتر</span><strong>@Model.ChapterCount</strong></div>
    <div class="instructor-stat-card"><span>الدروس</span><strong>@Model.LessonCount</strong></div>
    <div class="instructor-stat-card"><span>الموظفين</span><strong>@Model.AssignedEmployees</strong></div>
    <div class="instructor-stat-card"><span>الامتحانات</span><strong>@Model.ExamCount</strong></div>
    <div class="instructor-stat-card"><span>المدة</span><strong>@Model.DurationInHours</strong></div>
</section>

<section class="instructor-panel">
    <div class="instructor-panel-header">
        <div>
            <span class="instructor-kicker">Chapter Path</span>
            <h2>تقسيم الدروس على هيئة شباتر</h2>
        </div>
        <a asp-area="Instractor" asp-controller="InstructorChapters" asp-action="Create" asp-route-courseId="@Model.Id" class="btn btn-instructor-primary btn-sm">
            <i class="fas fa-plus"></i> شابتر جديد
        </a>
    </div>

    @if (!Model.Chapters.Any())
    {
        <div class="instructor-empty">
            <i class="fas fa-layer-group"></i>
            <h3>ابدأ بتقسيم الكورس لشباتر</h3>
            <p>اعمل شابتر، ضيف تحته الدروس، وبعدها حط الامتحان المناسب له.</p>
            <a asp-area="Instractor" asp-controller="InstructorChapters" asp-action="Create" asp-route-courseId="@Model.Id" class="btn btn-instructor-primary">
                إنشاء أول شابتر
            </a>
        </div>
    }
    else
    {
        <div class="chapter-track">
            @foreach (var chapter in Model.Chapters)
            {
                var chapterExam = chapter.Exams.FirstOrDefault();

                <article class="chapter-card">
                    <div class="chapter-header">
                        <div class="chapter-title-wrap">
                            <span class="chapter-order-badge">Chapter @chapter.Order</span>
                            <div>
                                <h3>@chapter.Title</h3>
                                <p>@chapter.Description</p>
                            </div>
                        </div>
                        <div class="chapter-actions">
                            <a asp-area="Instractor" asp-controller="InstructorLessons" asp-action="CreateLessons" asp-route-courseId="@Model.Id" asp-route-chapterId="@chapter.Id" class="btn btn-instructor-primary btn-sm">
                                <i class="fas fa-plus"></i> درس
                            </a>
                            @if (chapterExam == null)
                            {
                                <a asp-area="Instractor" asp-controller="InstructorExams" asp-action="Create" asp-route-courseId="@Model.Id" asp-route-chapterId="@chapter.Id" class="btn btn-instructor-light btn-sm">
                                    <i class="fas fa-clipboard-question"></i> امتحان
                                </a>
                            }
                            else
                            {
                                <a asp-area="Instractor" asp-controller="InstructorExams" asp-action="Edit" asp-route-id="@chapterExam.Id" class="btn btn-instructor-light btn-sm">
                                    <i class="fas fa-clipboard-check"></i> تعديل الامتحان
                                </a>
                            }
                            <a asp-area="Instractor" asp-controller="InstructorChapters" asp-action="Edit" asp-route-id="@chapter.Id" class="btn btn-instructor-light btn-sm">
                                <i class="fas fa-pen"></i>
                            </a>
                            <form asp-area="Instractor" asp-controller="InstructorChapters" asp-action="Delete" method="post" class="m-0" onsubmit="return confirm('هل تريد حذف هذا الشابتر؟');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@chapter.Id" />
                                <input type="hidden" name="courseId" value="@Model.Id" />
                                <button type="submit" class="btn btn-instructor-danger btn-sm"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                    </div>

                    <div class="chapter-metrics">
                        <span><i class="fas fa-book-open"></i>@chapter.LessonCount درس</span>
                        <span><i class="fas fa-clipboard-check"></i>@chapter.ExamCount امتحان</span>
                        <span><i class="fas fa-chart-line"></i>@chapter.AverageProgress% مشاهدة</span>
                    </div>

                    <div class="chapter-body-grid">
                        <div class="chapter-lessons">
                            <div class="chapter-section-head">
                                <span>الدروس</span>
                                <small>الموظف يذاكرها بالترتيب قبل امتحان الشابتر.</small>
                            </div>

                            @if (!chapter.Lessons.Any())
                            {
                                <div class="chapter-mini-empty">
                                    <i class="fas fa-circle-plus"></i>
                                    <span>لسه مفيش دروس في الشابتر ده.</span>
                                </div>
                            }
                            else
                            {
                                @foreach (var lesson in chapter.Lessons)
                                {
                                    <div class="chapter-lesson-row">
                                        <span class="lesson-order">@lesson.Order</span>
                                        <div>
                                            <strong>@lesson.Title</strong>
                                            <small>@lesson.CompletedEmployees مكتمل · @lesson.AverageWatchedPercentage% مشاهدة</small>
                                        </div>
                                        <div class="lesson-actions compact-actions">
                                            @if (!string.IsNullOrWhiteSpace(lesson.ContentUrl))
                                            {
                                                <a href="@lesson.ContentUrl" target="_blank" class="btn btn-instructor-light btn-sm"><i class="fas fa-eye"></i></a>
                                            }
                                            <a asp-area="Instractor" asp-controller="InstructorLessons" asp-action="EditLessons" asp-route-lessonId="@lesson.Id" class="btn btn-instructor-light btn-sm"><i class="fas fa-pen"></i></a>
                                            <form asp-area="Instractor" asp-controller="InstructorLessons" asp-action="Delete" method="post" class="m-0" onsubmit="return confirm('هل تريد حذف هذا الدرس؟');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="lessonId" value="@lesson.Id" />
                                                <input type="hidden" name="courseId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-instructor-danger btn-sm"><i class="fas fa-trash"></i></button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <div class="chapter-exam-card @(chapterExam == null ? "missing" : "")">
                            <div class="chapter-section-head">
                                <span>امتحان الشابتر</span>
                                <small>الانتقال للشابتر اللي بعده هيعتمد على اجتيازه في مرحلة الموظف.</small>
                            </div>

                            @if (chapterExam == null)
                            {
                                <i class="fas fa-lock-open"></i>
                                <h4>لسه مفيش امتحان</h4>
                                <p>ضيف الامتحان المناسب بعد انتهاء دروس الشابتر.</p>
                                <a asp-area="Instractor" asp-controller="InstructorExams" asp-action="Create" asp-route-courseId="@Model.Id" asp-route-chapterId="@chapter.Id" class="btn btn-instructor-primary btn-sm">
                                    إضافة امتحان
                                </a>
                            }
                            else
                            {
                                <span class="status-pill @(chapterExam.IsPublished ? "published" : "draft")">@(chapterExam.IsPublished ? "منشور" : "مسودة")</span>
                                <h4>@chapterExam.Title</h4>
                                <p>@chapterExam.Description</p>
                                <div class="exam-meta">
                                    <span><i class="fas fa-clock"></i>@chapterExam.DurationMinutes دقيقة</span>
                                    <span><i class="fas fa-star"></i>@chapterExam.PassingScore% نجاح</span>
                                    <span><i class="fas fa-circle-question"></i>@chapterExam.QuestionCount سؤال</span>
                                </div>
                                <div class="exam-actions">
                                    <a asp-area="Instractor" asp-controller="InstructorExams" asp-action="Edit" asp-route-id="@chapterExam.Id" class="btn btn-instructor-light btn-sm">تعديل</a>
                                    <form asp-area="Instractor" asp-controller="InstructorExams" asp-action="TogglePublish" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@chapterExam.Id" />
                                        <input type="hidden" name="courseId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-instructor-light btn-sm">@(chapterExam.IsPublished ? "إلغاء النشر" : "نشر")</button>
                                    </form>
                                    <form asp-area="Instractor" asp-controller="InstructorExams" asp-action="Delete" method="post" class="m-0" onsubmit="return confirm('هل تريد حذف هذا الامتحان؟');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@chapterExam.Id" />
                                        <input type="hidden" name="courseId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-instructor-danger btn-sm"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

@if (Model.Lessons.Any())
{
    <section class="instructor-panel">
        <div class="instructor-panel-header">
            <div>
                <span class="instructor-kicker">Unassigned</span>
                <h2>دروس غير مرتبطة بشابتر</h2>
            </div>
        </div>
        <div class="lesson-timeline">
            @foreach (var lesson in Model.Lessons)
            {
                <article class="lesson-card">
                    <div class="lesson-order">@lesson.Order</div>
                    <div class="lesson-content">
                        <h3>@lesson.Title</h3>
                        <p>@lesson.Description</p>
                        <div class="lesson-meta">
                            <span><i class="fas fa-check-circle"></i>@lesson.CompletedEmployees مكتمل</span>
                            <span><i class="fas fa-eye"></i>@lesson.AverageWatchedPercentage% مشاهدة</span>
                        </div>
                    </div>
                    <div class="lesson-actions">
                        <a asp-area="Instractor" asp-controller="InstructorLessons" asp-action="EditLessons" asp-route-lessonId="@lesson.Id" class="btn btn-instructor-light btn-sm">
                            <i class="fas fa-pen"></i> ربط بشابتر
                        </a>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (Model.Exams.Any())
{
    <section class="instructor-panel">
        <div class="instructor-panel-header">
            <div>
                <span class="instructor-kicker">Course Exams</span>
                <h2>امتحانات غير مرتبطة بشابتر</h2>
            </div>
        </div>
        <div class="exam-grid">
            @foreach (var exam in Model.Exams)
            {
                <article class="exam-card">
                    <span class="status-pill @(exam.IsPublished ? "published" : "draft")">@(exam.IsPublished ? "منشور" : "مسودة")</span>
                    <h3>@exam.Title</h3>
                    <p>@exam.Description</p>
                    <div class="exam-meta">
                        <span><i class="fas fa-clock"></i>@exam.DurationMinutes دقيقة</span>
                        <span><i class="fas fa-star"></i>@exam.PassingScore% نجاح</span>
                        <span><i class="fas fa-circle-question"></i>@exam.QuestionCount سؤال</span>
                    </div>
                    <div class="exam-actions">
                        <a asp-area="Instractor" asp-controller="InstructorExams" asp-action="Edit" asp-route-id="@exam.Id" class="btn btn-instructor-light btn-sm">ربط بشابتر</a>
                    </div>
                </article>
            }
        </div>
    </section>
}

<section class="instructor-panel">
    <div class="instructor-panel-header">
        <div>
            <span class="instructor-kicker">Employees</span>
            <h2>إنجازات الموظفين في هذا الكورس</h2>
        </div>
    </div>
    <div class="responsive-table">
        <table class="instructor-table">
            <thead>
                <tr>
                    <th>الموظف</th>
                    <th>الإنجاز</th>
                    <th>الدروس</th>
                    <th>الدرجة</th>
                    <th>الشارات</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var employee in Model.Employees)
                {
                    <tr>
                        <td><strong>@employee.Name</strong><small>@employee.Email</small></td>
                        <td><div class="table-progress"><span style="width:@employee.Progress%"></span></div><small>@employee.Progress%</small></td>
                        <td>@employee.CompletedLessons / @employee.TotalLessons</td>
                        <td>@(employee.FinalScore?.ToString("0.##") ?? "-")</td>
                        <td>@employee.BadgeCount</td>
                        <td>
                            <a asp-area="Instractor" asp-controller="InstructorProgress" asp-action="Details" asp-route-employeeId="@employee.EmployeeId" class="btn btn-instructor-light btn-sm">تفاصيل</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
