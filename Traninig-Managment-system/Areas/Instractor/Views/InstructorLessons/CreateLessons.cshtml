@model InstructorLessonFormVm

@{
    ViewData["Title"] = "إضافة درس";
}

<nav class="instructor-breadcrumb">
    <a asp-area="Instractor" asp-controller="Home" asp-action="DashBoard">Overview</a>
    <i class="fas fa-chevron-right"></i>
    <a asp-area="Instractor" asp-controller="Home" asp-action="Details" asp-route-id="@Model.CourseId">Course</a>
    <i class="fas fa-chevron-right"></i>
    <span>إضافة درس</span>
</nav>

<section class="instructor-form-shell">
    <div class="form-intro">
        <span class="instructor-kicker">New Lesson</span>
        <h1>إضافة درس جديد</h1>
        <p>ارفع فيديو أو PDF، واكتب وصف سريع يساعد الموظف يعرف هيتعلم إيه.</p>
    </div>

    <form asp-action="CreateLessons" method="post" enctype="multipart/form-data" class="instructor-form-card">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CourseId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-grid">
            @if (Model.ChapterOptions.Any())
            {
                <div class="full">
                    <label asp-for="ChapterId" class="form-label">الشابتر</label>
                    <select asp-for="ChapterId" class="form-select">
                        <option value="">بدون شابتر مؤقتاً</option>
                        @foreach (var chapter in Model.ChapterOptions)
                        {
                            <option value="@chapter.Id">Chapter @chapter.Order - @chapter.Title</option>
                        }
                    </select>
                    <span class="chapter-select-note">اختار الشابتر اللي الدرس ده هيظهر تحته.</span>
                </div>
            }
            else
            {
                <div class="chapter-select-note full">
                    اعمل شابتر الأول عشان تقدر ترتب الدروس جوه مسار واضح.
                </div>
            }
            <div>
                <label asp-for="Title" class="form-label">عنوان الدرس</label>
                <input asp-for="Title" class="form-control" placeholder="مثال: Introduction to onboarding" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Order" class="form-label">ترتيب الدرس</label>
                <input asp-for="Order" type="number" class="form-control" min="1" />
                <span asp-validation-for="Order" class="text-danger"></span>
            </div>
            <div class="full">
                <label class="form-label">ملف الدرس</label>
                <label class="upload-drop">
                    <i class="fas fa-cloud-arrow-up"></i>
                    <strong id="pdfFileLabel">PDF</strong>
                    <small>يمكن رفع ملفات كبيرة حسب إعدادات السيرفر</small>
                    <input asp-for="PdfFile" type="file" accept="application/pdf,.pdf" class="d-none" onchange="document.getElementById('pdfFileLabel').innerText = this.files[0]?.name || 'PDF';" />
                </label>
                <span asp-validation-for="PdfFile" class="text-danger"></span>
            </div>
            <div class="full">
                <label class="form-label">فيديو الدرس</label>
                <label class="upload-drop">
                    <i class="fas fa-cloud-arrow-up"></i>
                    <strong id="videoFileLabel">اختر فيديو</strong>
                    <small>يمكن رفع ملفات كبيرة حسب إعدادات السيرفر</small>
                    <input asp-for="VideoFile" type="file" accept="video/mp4,video/quicktime,video/webm,.mp4,.mov,.webm" class="d-none" onchange="document.getElementById('videoFileLabel').innerText = this.files[0]?.name || 'اختر فيديو';" />
                </label>
                <span asp-validation-for="VideoFile" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <a asp-area="Instractor" asp-controller="Home" asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-instructor-light">إلغاء</a>
            <button type="submit" class="btn btn-instructor-primary"><i class="fas fa-save"></i> حفظ الدرس</button>
        </div>
    </form>
</section>

@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
