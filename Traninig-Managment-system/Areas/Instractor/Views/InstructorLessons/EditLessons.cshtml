@model InstructorLessonFormVm

@{
    ViewData["Title"] = "تعديل درس";
}

<nav class="instructor-breadcrumb">
    <a asp-area="Instractor" asp-controller="Home" asp-action="DashBoard">Overview</a>
    <i class="fas fa-chevron-right"></i>
    <a asp-area="Instractor" asp-controller="Home" asp-action="Details" asp-route-id="@Model.CourseId">Course</a>
    <i class="fas fa-chevron-right"></i>
    <span>تعديل درس</span>
</nav>

<section class="instructor-form-shell">
    <div class="form-intro">
        <span class="instructor-kicker">Edit Lesson</span>
        <h1>تعديل الدرس</h1>
        <p>غيّر البيانات أو ارفع ملف جديد بدل الملف الحالي.</p>
    </div>

    <form asp-action="EditLessons" method="post" enctype="multipart/form-data" class="instructor-form-card">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CourseId" />
        <input type="hidden" asp-for="ExistingContentUrl" />
        <input type="hidden" asp-for="ExistingVideoUrl" />
        <input type="hidden" asp-for="ExistingPdfUrl" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-grid">
            @if (Model.ChapterOptions.Any())
            {
                <div class="full">
                    <label asp-for="ChapterId" class="form-label">الشابتر</label>
                    <select asp-for="ChapterId" class="form-select">
                        <option value="">بدون شابتر مؤقتاً</option>
                        @foreach (var chapter in Model.ChapterOptions)
                        {
                            <option value="@chapter.Id">Chapter @chapter.Order - @chapter.Title</option>
                        }
                    </select>
                    <span class="chapter-select-note">تقدر تنقل الدرس بين الشباتر من هنا.</span>
                </div>
            }
            <div>
                <label asp-for="Title" class="form-label">عنوان الدرس</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Order" class="form-label">ترتيب الدرس</label>
                <input asp-for="Order" type="number" class="form-control" min="1" />
                <span asp-validation-for="Order" class="text-danger"></span>
            </div>
            <div class="full">
                <label asp-for="Description" class="form-label">الوصف</label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="full">
                <label class="form-label">تغيير PDF الدرس</label>
                <label class="upload-drop">
                    <i class="fas fa-cloud-arrow-up"></i>
                    <strong id="pdfFileLabel">@(string.IsNullOrWhiteSpace(Model.ExistingPdfUrl) ? "اختر PDF" : "PDF الحالي محفوظ، ارفع ملف جديد للتبديل")</strong>
                    <small>@Model.ExistingPdfUrl</small>
                    <input asp-for="PdfFile" type="file" accept="application/pdf,.pdf" class="d-none" onchange="document.getElementById('pdfFileLabel').innerText = this.files[0]?.name || 'اختر PDF';" />
                </label>
                <span asp-validation-for="PdfFile" class="text-danger"></span>
            </div>
            <div class="full">
                <label class="form-label">تغيير فيديو الدرس</label>
                <label class="upload-drop">
                    <i class="fas fa-cloud-arrow-up"></i>
                    <strong id="videoFileLabel">@(string.IsNullOrWhiteSpace(Model.ExistingVideoUrl) ? "اختر فيديو" : "الفيديو الحالي محفوظ، ارفع ملف جديد للتبديل")</strong>
                    <small>@Model.ExistingVideoUrl</small>
                    <input asp-for="VideoFile" type="file" accept="video/mp4,video/quicktime,video/webm,.mp4,.mov,.webm" class="d-none" onchange="document.getElementById('videoFileLabel').innerText = this.files[0]?.name || 'اختر فيديو';" />
                </label>
                <span asp-validation-for="VideoFile" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <a asp-area="Instractor" asp-controller="Home" asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-instructor-light">إلغاء</a>
            <button type="submit" class="btn btn-instructor-primary"><i class="fas fa-check"></i> حفظ التعديل</button>
        </div>
    </form>
</section>

@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
