@model EmployeeExamResultVm

@{
    ViewData["Title"] = "Exam Result";
}

<section class="result-shell">
    <div class="result-card">
        <span class="pill @(Model.IsPassed ? "success" : "danger")">
            <i class="fas @(Model.IsPassed ? "fa-circle-check" : "fa-circle-xmark")"></i>
            @(Model.IsPassed ? "Passed" : "Needs Retry")
        </span>

        <h2>@Model.ExamTitle</h2>
        <p>@Model.CourseTitle</p>

        <div class="score-orb @(Model.IsPassed ? "success" : "danger")">
            <strong>@Model.ScorePercentage.ToString("0.#")%</strong>
            <span>Score</span>
        </div>

        <div class="meta-row center">
            <span><i class="fas fa-check"></i> @Model.CorrectAnswers / @Model.TotalQuestions correct</span>
            <span><i class="fas fa-percent"></i> Pass mark: @Model.PassingScore%</span>
            <span><i class="fas fa-rotate"></i> Attempt @Model.AttemptCount</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ChapterTitle))
        {
            <p class="result-note"><i class="fas fa-bookmark"></i> &nbsp;@Model.ChapterTitle</p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.AwardedBadgeName))
        {
            <div class="badge-banner">
                <strong><i class="fas fa-medal"></i> &nbsp;@Model.AwardedBadgeName</strong>
                <span>@Model.AwardedBadgeTier tier unlocked</span>
            </div>
        }

        @if (Model.CourseCompleted && Model.CertificateAvailable)
        {
            <div class="completion-banner">
                <h3><i class="fas fa-graduation-cap"></i> &nbsp;Course completed</h3>
                <p>Your certificate is ready to print right now.</p>
            </div>
        }

        <div class="inline-actions center">
            <a asp-area="Employee" asp-controller="EmployeeCourses" asp-action="Details"
               asp-route-courseId="@Model.CourseId" class="btn-soft">
                <i class="fas fa-arrow-left"></i> Back to course
            </a>
            @if (Model.CertificateAvailable)
            {
                <a asp-area="Employee" asp-controller="EmployeeCourses" asp-action="Certificate"
                   asp-route-courseId="@Model.CourseId" class="btn-solid">
                    <i class="fas fa-award"></i> Print certificate
                </a>
            }
            else
            {
                <a asp-area="Employee" asp-controller="Exams" asp-action="Take"
                   asp-route-examId="@Model.ExamId" class="btn-solid">
                    <i class="fas fa-rotate"></i> Try again
                </a>
            }
        </div>
    </div>
</section>
