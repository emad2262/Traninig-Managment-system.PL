@model EmployeeCourseDetailsVm

@{
    ViewData["Title"] = Model.Title;
}

<a asp-area="Employee" asp-controller="Home" asp-action="Dashboard" class="back-link">
    <i class="fas fa-arrow-left"></i>
    Back to dashboard
</a>

<section class="hero-card hero-split">
    <div>
        <p class="eyebrow">@Model.CategoryName</p>
        <h2>@Model.Title</h2>
        <p class="hero-copy">@Model.Description</p>
        <div class="meta-row">
            <span><i class="fas fa-user"></i> @Model.InstructorName</span>
            <span><i class="fas fa-chart-line"></i> @Model.ProgressPercentage% progress</span>
            <span><i class="fas fa-check-circle"></i> @Model.CompletedLessons / @Model.TotalLessons lessons</span>
        </div>
    </div>

    <div class="hero-actions">
        <span class="pill @(Model.CertificateAvailable ? "success" : "accent")">@Model.Status</span>
        @if (Model.NextLessonId.HasValue)
        {
            <a asp-area="Employee" asp-controller="Lessons" asp-action="Watch" asp-route-lessonId="@Model.NextLessonId.Value" class="btn-solid wide">Continue learning</a>
        }
        @if (Model.CertificateAvailable)
        {
            <a asp-area="Employee" asp-controller="EmployeeCourses" asp-action="Certificate" asp-route-courseId="@Model.CourseId" class="btn-soft wide">Print certificate</a>
        }
        @if (Model.FinalScore.HasValue)
        {
            <small>Current score average: @Model.FinalScore.Value.ToString("0.#")%</small>
        }
    </div>
</section>

<section class="course-layout">
    <div class="course-main">
        @if (Model.GeneralLessons.Any())
        {
            <div class="panel-card">
                <div class="panel-head">
                    <div>
                        <p class="eyebrow">General Lessons</p>
                        <h3>Course-wide content</h3>
                    </div>
                </div>

                <div class="lesson-list">
                    @foreach (var lesson in Model.GeneralLessons.OrderBy(l => l.Order))
                    {
                        <article class="lesson-row @(lesson.IsCompleted ? "done" : lesson.IsUnlocked ? "open" : "locked")">
                            <div class="lesson-state">
                                <i class="fas @(lesson.IsCompleted ? "fa-check" : lesson.IsUnlocked ? "fa-play" : "fa-lock")"></i>
                            </div>
                            <div class="lesson-copy">
                                <strong>@lesson.Title</strong>
                                <p>@lesson.Description</p>
                            </div>
                            <div class="inline-actions">
                                @if (lesson.IsUnlocked)
                                {
                                    <a asp-area="Employee" asp-controller="Lessons" asp-action="Watch" asp-route-lessonId="@lesson.LessonId" class="btn-soft">Open</a>
                                }
                                else
                                {
                                    <span class="pill subtle">Locked</span>
                                }
                            </div>
                        </article>
                    }
                </div>
            </div>
        }

        @foreach (var chapter in Model.Chapters.OrderBy(c => c.Order))
        {
            <article class="panel-card chapter-card-shell @(chapter.IsUnlocked ? string.Empty : "dimmed")">
                <div class="chapter-head">
                    <div>
                        <span class="chapter-order">Chapter @chapter.Order</span>
                        <h3>@chapter.Title</h3>
                        <p>@chapter.Description</p>
                    </div>
                    <div class="chapter-progress">
                        <span>@chapter.CompletedLessons / @chapter.TotalLessons lessons</span>
                        <strong>@(chapter.IsCompleted ? "Completed" : chapter.IsUnlocked ? "Active" : "Locked")</strong>
                    </div>
                </div>

                <div class="lesson-list">
                    @foreach (var lesson in chapter.Lessons.OrderBy(l => l.Order))
                    {
                        <article class="lesson-row @(lesson.IsCompleted ? "done" : lesson.IsUnlocked ? "open" : "locked")">
                            <div class="lesson-state">
                                <i class="fas @(lesson.IsCompleted ? "fa-check" : lesson.IsUnlocked ? "fa-play" : "fa-lock")"></i>
                            </div>
                            <div class="lesson-copy">
                                <strong>@lesson.Title</strong>
                                <p>@lesson.Description</p>
                            </div>
                            <div class="inline-actions">
                                @if (lesson.IsUnlocked)
                                {
                                    <a asp-area="Employee" asp-controller="Lessons" asp-action="Watch" asp-route-lessonId="@lesson.LessonId" class="btn-soft">Watch lesson</a>
                                }
                                else
                                {
                                    <span class="pill subtle">Locked</span>
                                }
                            </div>
                        </article>
                    }
                </div>

                @if (chapter.Exam != null)
                {
                    <div class="exam-highlight @(chapter.Exam.IsPassed ? "passed" : chapter.Exam.IsUnlocked ? "ready" : "waiting")">
                        <div>
                            <span class="eyebrow">Chapter Exam</span>
                            <h4>@chapter.Exam.Title</h4>
                            <p>@chapter.Exam.Description</p>
                            <div class="meta-row">
                                <span><i class="fas fa-clock"></i> @chapter.Exam.DurationMinutes min</span>
                                <span><i class="fas fa-star"></i> Pass at @chapter.Exam.PassingScore%</span>
                                <span><i class="fas fa-rotate"></i> @chapter.Exam.AttemptCount attempt(s)</span>
                            </div>
                        </div>
                        <div class="hero-actions">
                            <span class="pill @(chapter.Exam.IsPassed ? "success" : chapter.Exam.IsUnlocked ? "accent" : "subtle")">@chapter.Exam.StatusText</span>
                            @if (chapter.Exam.IsUnlocked)
                            {
                                <a asp-area="Employee" asp-controller="Exams" asp-action="Take" asp-route-examId="@chapter.Exam.ExamId" class="btn-solid wide">
                                    @(chapter.Exam.IsPassed ? "Retake exam" : "Start exam")
                                </a>
                            }
                        </div>
                    </div>
                }
            </article>
        }

        @if (Model.FinalAssessments.Any())
        {
            <div class="panel-card">
                <div class="panel-head">
                    <div>
                        <p class="eyebrow">Final Assessments</p>
                        <h3>Course-level exams</h3>
                    </div>
                </div>

                <div class="assessment-grid">
                    @foreach (var exam in Model.FinalAssessments)
                    {
                        <article class="assessment-card">
                            <span class="pill @(exam.IsPassed ? "success" : exam.IsUnlocked ? "accent" : "subtle")">@exam.StatusText</span>
                            <h4>@exam.Title</h4>
                            <p>@exam.Description</p>
                            <div class="meta-row">
                                <span>@exam.DurationMinutes min</span>
                                <span>@exam.PassingScore% pass</span>
                            </div>
                            @if (exam.IsUnlocked)
                            {
                                <a asp-area="Employee" asp-controller="Exams" asp-action="Take" asp-route-examId="@exam.ExamId" class="btn-soft">Open exam</a>
                            }
                        </article>
                    }
                </div>
            </div>
        }
    </div>

    <aside class="course-side">
        <div class="panel-card">
            <div class="panel-head">
                <div>
                    <p class="eyebrow">Achievements</p>
                    <h3>Latest badges</h3>
                </div>
            </div>

            @if (!Model.EarnedBadges.Any())
            {
                <div class="empty-mini">No badges earned yet in your learning path.</div>
            }
            else
            {
                <div class="badge-grid compact">
                    @foreach (var badge in Model.EarnedBadges)
                    {
                        <article class="badge-card">
                            <span class="pill tier-@badge.Tier.ToLowerInvariant()">@badge.Tier</span>
                            <h4>@badge.Name</h4>
                            <p>@badge.Reason</p>
                        </article>
                    }
                </div>
            }
        </div>
    </aside>
</section>
