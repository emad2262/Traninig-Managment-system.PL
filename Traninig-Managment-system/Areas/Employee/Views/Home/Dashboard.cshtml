@model EmployeeDashboardVm

@{
    ViewData["Title"] = "Dashboard";
    var firstName = string.IsNullOrWhiteSpace(Model.EmployeeName)
        ? "Learner"
        : Model.EmployeeName.Split(' ')[0];
}

<section class="hero-card">
    <div>
        <p class="eyebrow">Welcome back</p>
        <h2>Hi @firstName 👋</h2>
        <p class="hero-copy">
            Track your assigned courses, watch lessons at your own pace, conquer chapter exams,
            and unlock certificates as soon as every milestone is finished.
        </p>
        <div class="meta-row">
            <span><i class="fas fa-circle-check"></i> @Model.TotalCompletedLessons lessons completed</span>
            <span><i class="fas fa-fire"></i> @Model.TotalPoints learning points</span>
        </div>
    </div>
    <div class="hero-badge">
        <strong>@Model.AverageProgress%</strong>
        <span>Average progress</span>
    </div>
</section>

<section class="stats-grid">
    <article class="stat-card">
        <span><i class="fas fa-layer-group"></i> &nbsp;Total Courses</span>
        <strong>@Model.TotalCourses</strong>
    </article>
    <article class="stat-card">
        <span><i class="fas fa-graduation-cap"></i> &nbsp;Completed</span>
        <strong>@Model.CompletedCourses</strong>
    </article>
    <article class="stat-card">
        <span><i class="fas fa-star"></i> &nbsp;Learning Points</span>
        <strong>@Model.TotalPoints</strong>
    </article>
    <article class="stat-card">
        <span><i class="fas fa-award"></i> &nbsp;Certificates</span>
        <strong>@Model.CertificatesCount</strong>
    </article>
</section>

<section class="dashboard-grid" id="courses">
    <div class="panel-card">
        <div class="panel-head">
            <div>
                <p class="eyebrow">Assigned Courses</p>
                <h3>Keep moving through your roadmap</h3>
            </div>
        </div>

        @if (!Model.Courses.Any())
        {
            <div class="empty-state">
                <i class="fas fa-book-open"></i>
                <h4>No courses assigned yet</h4>
                <p>Once your manager adds you to a training plan, the courses will land here.</p>
            </div>
        }
        else
        {
            <div class="course-stack">
                @foreach (var course in Model.Courses)
                {
                    <article class="course-card">
                        <div class="course-card-top">
                            <div>
                                <span class="pill subtle">@course.CategoryName</span>
                                <h4>@course.Title</h4>
                                <p>@course.Description</p>
                            </div>
                            <span class="pill @(course.CertificateAvailable ? "success" : "accent")">@course.Status</span>
                        </div>

                        <div class="meta-row">
                            <span><i class="fas fa-chalkboard-teacher"></i> @course.InstructorName</span>
                            <span><i class="fas fa-list-check"></i> @course.CompletedLessons / @course.TotalLessons lessons</span>
                            <span><i class="fas fa-chart-line"></i> @course.ProgressPercentage%</span>
                        </div>

                        <div class="progress-track">
                            <span style="width:@course.ProgressPercentage%"></span>
                        </div>

                        <div class="course-card-bottom">
                            <small><i class="fas fa-circle-info"></i> @course.Highlight</small>
                            <div class="inline-actions">
                                @if (course.NextLessonId.HasValue)
                                {
                                    <a asp-area="Employee" asp-controller="Lessons" asp-action="Watch"
                                       asp-route-lessonId="@course.NextLessonId.Value" class="btn-solid">
                                        <i class="fas fa-play"></i> Continue
                                    </a>
                                }
                                else
                                {
                                    <a asp-area="Employee" asp-controller="EmployeeCourses" asp-action="Details"
                                       asp-route-courseId="@course.CourseId" class="btn-solid">
                                        <i class="fas fa-arrow-right"></i> Open Course
                                    </a>
                                }

                                @if (course.CertificateAvailable)
                                {
                                    <a asp-area="Employee" asp-controller="EmployeeCourses" asp-action="Certificate"
                                       asp-route-courseId="@course.CourseId" class="btn-soft">
                                        <i class="fas fa-award"></i> Certificate
                                    </a>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>

    <div class="side-stack">
        <div class="panel-card">
            <div class="panel-head">
                <div>
                    <p class="eyebrow">Achievements</p>
                    <h3>Badges earned</h3>
                </div>
            </div>

            @if (!Model.Badges.Any())
            {
                <div class="empty-mini">
                    <i class="fas fa-medal" style="margin-right:8px;color:var(--gold);"></i>
                    Pass chapter exams to start collecting badges.
                </div>
            }
            else
            {
                <div class="badge-grid">
                    @foreach (var badge in Model.Badges.Take(6))
                    {
                        <article class="badge-card">
                            <span class="pill tier-@badge.Tier.ToLowerInvariant()">@badge.Tier</span>
                            <h4>@badge.Name</h4>
                            <p>@badge.Reason</p>
                            <small>+@badge.Points pts</small>
                        </article>
                    }
                </div>
            }
        </div>

        <div class="panel-card">
            <div class="panel-head">
                <div>
                    <p class="eyebrow">Timeline</p>
                    <h3>Recent activity</h3>
                </div>
            </div>

            @if (!Model.RecentActivity.Any())
            {
                <div class="empty-mini">
                    <i class="fas fa-clock-rotate-left" style="margin-right:8px;"></i>
                    Your latest learning moves will show up here.
                </div>
            }
            else
            {
                <div class="timeline-list">
                    @foreach (var item in Model.RecentActivity)
                    {
                        <article class="timeline-item">
                            <div class="timeline-dot @item.Kind"></div>
                            <div>
                                <strong>@item.Title</strong>
                                <p>@item.Subtitle</p>
                            </div>
                            <time>@item.HappenedAt.ToLocalTime().ToString("dd MMM, HH:mm")</time>
                        </article>
                    }
                </div>
            }
        </div>
    </div>
</section>
