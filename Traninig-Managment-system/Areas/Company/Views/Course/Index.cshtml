@model IEnumerable<CourseDto>

@{
    ViewData["Title"] = "إدارة الكورسات";
    int? categoryId = ViewBag.CategoryId as int?;
    var isCategoryView = ViewBag.IsCategoryView == true;
}

<div class="course-manage-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success course-alert">
            <i class="bi bi-check-circle"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger course-alert">
            <i class="bi bi-exclamation-triangle"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <div class="course-page-header">
        <div>
            <span class="course-kicker">Courses</span>
            <h1>@(isCategoryView ? "كورسات القسم" : "كل كورسات الشركة")</h1>
            <p>تابع الكورسات، عدل بياناتها، وانشرها للموظفين من مكان واحد.</p>
        </div>
        <div class="course-header-actions">
            <a asp-area="Company" asp-controller="Category" asp-action="Index" class="btn btn-course-light">
                <i class="bi bi-arrow-left"></i>
                <span>الأقسام</span>
            </a>
            @if (categoryId.HasValue)
            {
                <a asp-action="Create" asp-route-categoryId="@categoryId" class="btn btn-course-primary">
                    <i class="bi bi-plus-lg"></i>
                    <span>إضافة كورس</span>
                </a>
            }
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="course-empty-state">
            <div class="course-empty-icon"><i class="bi bi-journal-plus"></i></div>
            <h2>لا توجد كورسات حتى الآن</h2>
            <p>ابدأ بإضافة أول كورس داخل القسم الحالي.</p>
            @if (categoryId.HasValue)
            {
                <a asp-action="Create" asp-route-categoryId="@categoryId" class="btn btn-course-primary">إنشاء أول كورس</a>
            }
        </div>
    }
    else
    {
        <div class="course-grid">
            @foreach (var course in Model)
            {
                var currentCategoryId = categoryId ?? course.CategoryId;
                <article class="course-card">
                    <a asp-action="Details" asp-route-id="@course.Id" asp-route-categoryId="@currentCategoryId" class="course-thumb">
                        @if (!string.IsNullOrWhiteSpace(course.Logo))
                        {
                            <img src="@course.Logo" alt="@course.Title" />
                        }
                        else
                        {
                            <div class="course-thumb-placeholder"><i class="bi bi-journal-bookmark"></i></div>
                        }
                        <span class="course-status @(course.IsPublished ? "published" : "draft")">
                            @(course.IsPublished ? "منشور" : "مسودة")
                        </span>
                    </a>

                    <div class="course-card-body">
                        <div class="course-card-topline">
                            <span>@(string.IsNullOrWhiteSpace(course.CategoryName) ? "قسم تدريبي" : course.CategoryName)</span>
                            <span>@course.DurationInHours ساعة</span>
                        </div>
                        <h2>
                            <a asp-action="Details" asp-route-id="@course.Id" asp-route-categoryId="@currentCategoryId">@course.Title</a>
                        </h2>
                        <p>@course.Description</p>
                        <div class="course-meta-list">
                            <span><i class="bi bi-person-badge"></i>@(string.IsNullOrWhiteSpace(course.InstructorName) ? "بدون مدرب" : course.InstructorName)</span>
                            <span><i class="bi bi-calendar-event"></i>@course.StartDate.ToString("dd MMM yyyy")</span>
                            <span><i class="bi bi-calendar-check"></i>@course.EndDate.ToString("dd MMM yyyy")</span>
                        </div>
                    </div>

                    <div class="course-card-actions">
                        <a asp-action="Details" asp-route-id="@course.Id" asp-route-categoryId="@currentCategoryId" class="btn btn-course-light btn-sm">
                            <i class="bi bi-eye"></i><span>تفاصيل</span>
                        </a>
                        <a asp-action="Edit" asp-route-id="@course.Id" asp-route-categoryId="@currentCategoryId" class="btn btn-course-icon btn-sm" title="تعديل">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="TogglePublish" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@course.Id" />
                            <input type="hidden" name="categoryId" value="@currentCategoryId" />
                            <button type="submit" class="btn btn-course-icon btn-sm" title="تغيير حالة النشر">
                                <i class="bi @(course.IsPublished ? "bi-eye-slash" : "bi-broadcast")"></i>
                            </button>
                        </form>
                        <form asp-action="Delete" method="post" class="m-0" onsubmit="return confirm('هل تريد حذف هذا الكورس؟');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@course.Id" />
                            <input type="hidden" name="categoryId" value="@currentCategoryId" />
                            <button type="submit" class="btn btn-course-danger btn-sm" title="حذف"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
</div>
