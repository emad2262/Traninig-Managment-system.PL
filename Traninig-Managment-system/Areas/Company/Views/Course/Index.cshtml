@model IEnumerable<CourseDto>

@{
    ViewData["Title"] = "إدارة الكورسات";
    // نفترض أنك تمرر CategoryId عبر الـ ViewBag من الكنترولر
    var catId = ViewBag.CategoryId; 
}

<div class="container py-4">
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="page-header">
        <h2 class="text-dark fw-bold m-0"><i class="fas fa-layer-group me-2" style="color: var(--corporate-blue);"></i> الكورسات التدريبية</h2>
        <a asp-action="Create" asp-route-categoryId="@catId" class="btn btn-create-modern text-decoration-none">
            <i class="fas fa-plus me-1"></i> إضافة كورس جديد
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-box-open"></i>
            <h4 class="text-dark fw-bold">لا توجد كورسات في هذا القسم بعد</h4>
            <p class="text-muted mb-4">ابدأ بإنشاء الكورس الأول ليتمكن المتدربون من الوصول إليه.</p>
            <a asp-action="Create" asp-route-categoryId="@catId" class="btn btn-create-modern">
                إضافة الكورس الأول
            </a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var course in Model)
            {
                <div class="col">
                    <div class="course-card d-flex flex-column">
                        <div class="course-logo-wrapper position-relative">
                            <img src="@(string.IsNullOrEmpty(course.Logo) ? "/images/default-course.png" : course.Logo)" alt="Course Logo" class="course-logo" onerror="this.src='/images/default-course.png';">
                            
                            <span class="badge @(course.IsPublished ? "bg-success" : "bg-warning text-dark") position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill shadow-sm">
                                @(course.IsPublished ? "منشور" : "مسودة")
                            </span>
                        </div>
                        
                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="card-title fw-bold text-dark mb-2">@course.Title</h5>
                            <p class="card-text course-desc mb-4">@course.Description</p>
                            
                            <div class="mt-auto">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-user-tie text-muted me-2 width-20"></i>
                                    <span class="text-dark fw-semibold">المدرب: @(course.InstructorId.HasValue ? "تم التعيين" : "غير محدد")</span>
                                </div>
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-calendar-alt text-muted me-2 width-20"></i>
                                    <span class="text-muted small">@course.StartDate.ToString("dd MMM yyyy") - @course.EndDate.ToString("dd MMM yyyy")</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-clock text-muted me-2 width-20"></i>
                                    <span class="text-muted small">@course.DurationInHours ساعة تدريبية</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="card-footer bg-white border-top-0 p-4 pt-0 d-flex justify-content-between">
                            <button class="btn btn-sm btn-outline-primary fw-bold w-100 rounded-3">إدارة الكورس</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>