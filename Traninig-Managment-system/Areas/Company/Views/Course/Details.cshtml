@model CourseDetailsVM

@{
    ViewData["Title"] = Model.Title;
    var totalDays = Math.Max(0, (Model.EndDate.Date - Model.StartDate.Date).Days);
}

<div class="era-course">

    <nav class="c-crumb">
        <a asp-action="Index">Courses</a>
        <i class="bi bi-chevron-right" style="font-size:.6rem"></i>
        <span>@Model.Title</span>
    </nav>

    <!-- ===================== HERO ===================== -->
    <section class="c-hero c-rise" style="--delay:.05s">

        <div class="c-hero__thumb">
            @if (!string.IsNullOrWhiteSpace(Model.Logo))
            {
                <img src="@Model.Logo" alt="@Model.Title" />
            }
            else
            {
                <div class="c-card__placeholder"><i class="bi bi-journal-richtext"></i></div>
            }
        </div>

        <div>
            <span class="c-chip @(Model.IsPublished ? "c-chip--live" : "c-chip--draft")">
                @(Model.IsPublished ? "Published" : "Draft")
            </span>

            <h1 class="c-hero__title">@Model.Title</h1>
            <p class="c-hero__desc">@Model.Description</p>

            <div class="c-hero__facts">
                <div>
                    <b>@Model.DurationInHours h</b>
                    <span>Duration</span>
                </div>
                <div>
                    <b>@Model.Lessons.Count</b>
                    <span>Lessons</span>
                </div>
                <div>
                    <b>@totalDays d</b>
                    <span>Window</span>
                </div>
            </div>

            <div class="c-hero__actions">
                <a class="c-btn c-btn--onink" asp-action="Edit" asp-route-id="@Model.Id">
                    <i class="bi bi-pencil"></i> Edit course
                </a>

                <form asp-action="TogglePublish" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <button type="submit" class="c-btn c-btn--onink">
                        <i class="bi @(Model.IsPublished ? "bi-eye-slash" : "bi-send")"></i>
                        @(Model.IsPublished ? "Move to draft" : "Publish now")
                    </button>
                </form>
            </div>
        </div>

    </section>

    <!-- ===================== BODY ===================== -->
    <section class="c-section c-rise" style="--delay:.12s">
        <div class="c-section__head">
            <h2 class="c-section__title">Course record</h2>
            <span class="c-section__rule"></span>
        </div>

        <div class="row g-3">

            <!-- Lessons -->
            <div class="col-lg-7">
                <div class="c-panel">
                    <div class="c-panel__head">
                        <h3 class="c-panel__title">Lessons</h3>
                        <span class="c-panel__meta">@Model.Lessons.Count total</span>
                    </div>

                    @if (!Model.Lessons.Any())
                    {
                        <div class="c-empty" style="border:0;padding:2.25rem 1rem 1rem">
                            <i class="bi bi-collection-play"></i>
                            <h3>No lessons yet</h3>
                            <p>Add lessons with videos or PDFs so employees have something to work through.</p>
                        </div>
                    }
                    else
                    {
                        <ul class="c-lessons">
                            @foreach (var lesson in Model.Lessons)
                            {
                                <li>
                                    <span class="c-lesson__no">@lesson.Order</span>
                                    <span class="c-lesson__text">
                                        <span class="c-lesson__title">@lesson.Title</span>
                                        @if (!string.IsNullOrWhiteSpace(lesson.Content))
                                        {
                                            <span class="c-lesson__desc">@lesson.Content</span>
                                        }
                                    </span>
                                    <span class="c-lesson__files">
                                        @if (!string.IsNullOrWhiteSpace(lesson.VideoUrl))
                                        {
                                            <a class="c-filepill" href="@lesson.VideoUrl" target="_blank" rel="noopener">
                                                <i class="bi bi-play-circle"></i> Video
                                            </a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(lesson.PdfUrl))
                                        {
                                            <a class="c-filepill" href="@lesson.PdfUrl" target="_blank" rel="noopener">
                                                <i class="bi bi-file-earmark-pdf"></i> PDF
                                            </a>
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <!-- Meta -->
            <div class="col-lg-5">
                <div class="c-panel">
                    <div class="c-panel__head">
                        <h3 class="c-panel__title">Details</h3>
                    </div>

                    <ul class="c-ledger">
                        <li>
                            <span class="c-ledger__label">Category</span>
                            <span class="c-ledger__lead"></span>
                            <span class="c-ledger__value">@Model.CategoryName</span>
                        </li>
                        <li>
                            <span class="c-ledger__label">Instructor</span>
                            <span class="c-ledger__lead"></span>
                            <span class="c-ledger__value">@Model.InstructorName</span>
                        </li>
                        <li>
                            <span class="c-ledger__label">Starts on</span>
                            <span class="c-ledger__lead"></span>
                            <span class="c-ledger__value">@Model.StartDate.ToString("dd MMM yyyy")</span>
                        </li>
                        <li>
                            <span class="c-ledger__label">Ends on</span>
                            <span class="c-ledger__lead"></span>
                            <span class="c-ledger__value">@Model.EndDate.ToString("dd MMM yyyy")</span>
                        </li>
                        <li>
                            <span class="c-ledger__label">Duration</span>
                            <span class="c-ledger__lead"></span>
                            <span class="c-ledger__value">@Model.DurationInHours h</span>
                        </li>
                        <li>
                            <span class="c-ledger__label">Status</span>
                            <span class="c-ledger__lead"></span>
                            <span class="c-ledger__value">@(Model.IsPublished ? "Published" : "Draft")</span>
                        </li>
                    </ul>

                    <div class="c-formfoot">
                        <button type="button" class="c-btn c-btn--danger c-btn--block"
                                data-bs-toggle="modal" data-bs-target="#deleteCourseModal">
                            <i class="bi bi-trash3"></i> Delete this course
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </section>

    @if (TempData["Success"] != null)
    {
        <div class="c-toast c-toast--ok" data-toast>
            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="c-toast c-toast--err" data-toast>
            <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
        </div>
    }

</div>

<!-- ===================== DELETE MODAL ===================== -->
<div class="modal fade era-modal" id="deleteCourseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete course</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Deleting <strong>@Model.Title</strong> also removes its @Model.Lessons.Count lessons and
                every file uploaded to them. This cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="c-btn c-btn--ghost" data-bs-dismiss="modal">Keep it</button>
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="c-btn c-btn--danger">
                        <i class="bi bi-trash3"></i> Delete course
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        setTimeout(function() {
            document.querySelectorAll('[data-toast]').forEach(function(t) { t.remove(); });
        }, 4000);
    </script>
}
