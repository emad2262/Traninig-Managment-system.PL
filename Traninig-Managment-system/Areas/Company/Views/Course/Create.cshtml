@model CreateCourseVM

@{
    ViewData["Title"] = "New course";
}

<div class="era-course">

    <nav class="c-crumb">
        <a asp-action="Index">Courses</a>
        <i class="bi bi-chevron-right" style="font-size:.6rem"></i>
        <span>New</span>
    </nav>

    <header class="c-head c-rise" style="--delay:.05s">
        <div class="c-head__row">
            <div>
                <span class="c-kicker">ERA &middot; Catalog</span>
                <h1 class="c-title">Create a course</h1>
                <p class="c-sub">Save it as a draft first, or publish it right away so employees can enroll.</p>
            </div>
        </div>
    </header>

    <div class="row justify-content-center mt-4">
        <div class="col-xl-9">

            <form asp-action="Create" method="post" enctype="multipart/form-data"
                  class="c-form c-rise" style="--delay:.1s" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="c-alert"></div>

                <!-- ---------------- BASICS ---------------- -->
                <section class="c-fieldset">
                    <div class="c-fieldset__head">
                        <h2 class="c-fieldset__title">Basics</h2>
                        <span class="c-fieldset__rule"></span>
                    </div>

                    <div class="c-field">
                        <label asp-for="Title"></label>
                        <input asp-for="Title" type="text" placeholder="e.g. Workplace Safety Fundamentals" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="c-field">
                        <label asp-for="Description"></label>
                        <textarea asp-for="Description" placeholder="What will employees learn, and who is it for?"></textarea>
                        <span class="c-hint">This is what employees read before enrolling.</span>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="c-field">
                                <label asp-for="CategoryId">Category</label>
                                <select asp-for="CategoryId" asp-items="Model.Categories">
                                    <option value="">Pick a category</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="c-field">
                                <label asp-for="InstructorId">Instructor</label>
                                <select asp-for="InstructorId" asp-items="Model.Instructors">
                                    <option value="">Pick an instructor</option>
                                </select>
                                <span asp-validation-for="InstructorId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ---------------- SCHEDULE ---------------- -->
                <section class="c-fieldset">
                    <div class="c-fieldset__head">
                        <h2 class="c-fieldset__title">Schedule</h2>
                        <span class="c-fieldset__rule"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="c-field">
                                <label asp-for="DurationInHours"></label>
                                <input asp-for="DurationInHours" type="number" min="1" max="1000" />
                                <span asp-validation-for="DurationInHours" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="c-field">
                                <label asp-for="StartDate"></label>
                                <input asp-for="StartDate" type="date" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="c-field">
                                <label asp-for="EndDate"></label>
                                <input asp-for="EndDate" type="date" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ---------------- MEDIA ---------------- -->
                <section class="c-fieldset">
                    <div class="c-fieldset__head">
                        <h2 class="c-fieldset__title">Cover image</h2>
                        <span class="c-fieldset__rule"></span>
                    </div>

                    <div class="c-upload">
                        <div class="c-upload__preview" id="logoPreview">
                            <i class="bi bi-image"></i>
                        </div>
                        <div class="c-upload__body">
                            <b>Course logo</b>
                            <span>JPG, PNG, or WebP &middot; up to 2 MB &middot; 16:10 looks best</span>
                            <label class="c-upload__pick" for="Logo">
                                <i class="bi bi-upload"></i> Choose image
                            </label>
                            <input asp-for="Logo" id="Logo" type="file" accept="image/png,image/jpeg,image/webp" />
                            <span asp-validation-for="Logo" class="text-danger"></span>
                        </div>
                    </div>
                </section>

                <!-- ---------------- VISIBILITY ---------------- -->
                <section class="c-fieldset">
                    <div class="c-fieldset__head">
                        <h2 class="c-fieldset__title">Visibility</h2>
                        <span class="c-fieldset__rule"></span>
                    </div>

                    <label class="c-switch">
                        <input asp-for="IsPublished" type="checkbox" />
                        <span class="c-switch__track"></span>
                        <span class="c-switch__text">
                            <b>Publish immediately</b>
                            <span>Leave this off to save it as a draft only your team can see.</span>
                        </span>
                    </label>
                </section>

                <div class="c-formfoot">
                    <a class="c-btn c-btn--ghost" asp-action="Index">Cancel</a>
                    <button type="submit" class="c-btn c-btn--primary">
                        <i class="bi bi-check-lg"></i> Create course
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // معاينة الصورة قبل الرفع
        (function() {
            const input = document.getElementById('Logo');
            const preview = document.getElementById('logoPreview');
            if (!input) return;

            input.addEventListener('change', function() {
                const file = this.files && this.files[0];
                if (!file) return;

                const url = URL.createObjectURL(file);
                preview.innerHTML = '<img src="' + url + '" alt="Selected cover" />';
            });
        })();
    </script>
}
