@model IEnumerable<ListInstructorVm>
@{
    ViewData["Title"] = "Instructors";
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success-custom">
        @TempData["SuccessMessage"]
    </div>
}

<div class="instructors-page">

    <!-- Header -->
    <div class="page-header">
        <div>
            <span class="page-badge">Company Area</span>
            <h1>Instructors</h1>
            <p>Manage your company instructors, specializations, and assigned courses.</p>
        </div>

        <a asp-action="Create" class="btn-primary-custom">
            <span>+</span>
            Add Instructor
        </a>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon instructor-icon">👨‍🏫</div>
            <div>
                <p>Total Instructors</p>
                <h3>@Model.Count()</h3>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon active-icon">✓</div>
            <div>
                <p>Available</p>
                <h3>@Model.Count()</h3>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon date-icon">📅</div>
            <div>
                <p>Latest Added</p>
                <h3>
                    @{
                        var latest = Model.OrderByDescending(x => x.CreatedAt).FirstOrDefault();
                    }

                    @if (latest != null)
                    {
                        @latest.CreatedAt.ToString("dd MMM")
                    }
                    else
                    {
                        <span>-</span>
                    }
                </h3>
            </div>
        </div>
    </div>

    <!-- Search / Filter UI -->
    <div class="toolbar-card">
        <div class="search-box">
            <span>🔍</span>
            <input type="text" id="instructorSearch" placeholder="Search instructor by name or specialization..." />
        </div>
    </div>

    <!-- Instructors Table -->
    <div class="table-card">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="custom-table" id="instructorsTable">
                    <thead>
                        <tr>
                            <th>Instructor</th>
                            <th>Specialization</th>
                            <th>Created At</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var instructor in Model)
                        {
                            <tr>
                                <td>
                                    <div class="instructor-info">
                                        <div class="avatar">
                                            @GetInitials(instructor.FullName)
                                        </div>

                                        <div>
                                            <h4>@instructor.FullName</h4>
                                            <p>ID: #@instructor.Id</p>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="specialization-pill">
                                        @instructor.Specialization
                                    </span>
                                </td>

                                <td>
                                    <div class="date-text">
                                        @instructor.CreatedAt.ToString("dd MMM yyyy")
                                    </div>
                                </td>

                                <td>
                                    <div class="actions">
                                        <a asp-action="Details"
                                           asp-route-id="@instructor.Id"
                                           class="btn-action btn-details">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@instructor.Id"
                                           class="btn-action btn-edit">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@instructor.Id"
                                           class="btn-action btn-delete">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">👨‍🏫</div>
                <h3>No instructors found</h3>
                <p>You have not added any instructors yet. Start by creating your first instructor.</p>

                <a asp-action="Create" class="btn-primary-custom">
                    Add First Instructor
                </a>
            </div>
        }
    </div>
</div>

@functions {
    private string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "IN";

        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
            return parts[0].Substring(0, 1).ToUpper();

        return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }
}

@section Scripts {
    <script>
        const searchInput = document.getElementById("instructorSearch");
        const table = document.getElementById("instructorsTable");

        if (searchInput && table) {
            searchInput.addEventListener("keyup", function () {
                const value = this.value.toLowerCase();
                const rows = table.querySelectorAll("tbody tr");

                rows.forEach(row => {
                    const text = row.innerText.toLowerCase();
                    row.style.display = text.includes(value) ? "" : "none";
                });
            });
        }
    </script>
}
