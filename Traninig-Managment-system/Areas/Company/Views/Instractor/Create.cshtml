@model CreateInstructorVm
@{
    ViewData["Title"] = "Create Instructor";
}

<div class="create-instructor-page">

    <div class="page-header">
        <div>
            <span class="page-badge">Company Area</span>
            <h1>Create Instructor</h1>
            <p>Add a new instructor account and connect it to your company.</p>
        </div>

        <a asp-action="Index" class="btn-back-custom">
            ← Back to Instructors
        </a>
    </div>

    <div class="form-layout">

        <div class="form-card">
            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="validation-summary"></div>

                <div class="form-section-title">
                    <div class="section-icon">👨‍🏫</div>
                    <div>
                        <h3>Instructor Information</h3>
                        <p>Enter the basic information for the instructor.</p>
                    </div>
                </div>

                <div class="form-grid">

                    <div class="form-group">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" class="form-control-custom" placeholder="Enter instructor full name" />
                        <span asp-validation-for="Name" class="field-validation"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" class="form-control-custom" placeholder="example@email.com" />
                        <span asp-validation-for="Email" class="field-validation"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Specialization"></label>
                        <input asp-for="Specialization" class="form-control-custom" placeholder="Example: Backend Development" />
                        <span asp-validation-for="Specialization" class="field-validation"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" class="form-control-custom" placeholder="Enter password" />
                        <span asp-validation-for="Password" class="field-validation"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ConfirmPassword"></label>
                        <input asp-for="ConfirmPassword" class="form-control-custom" placeholder="Confirm password" />
                        <span asp-validation-for="ConfirmPassword" class="field-validation"></span>
                    </div>

                </div>

                <div class="form-actions">
                    <a asp-action="Index" class="btn-cancel">
                        Cancel
                    </a>

                    <button type="submit" class="btn-submit">
                        <span>+</span>
                        Create Instructor
                    </button>
                </div>

            </form>
        </div>

        <div class="side-card">
            <div class="side-icon">💡</div>
            <h3>Quick Note</h3>
            <p>
                The instructor email will be used as the login username.
                Make sure the email is unique and the password follows Identity rules.
            </p>

            <div class="note-list">
                <div>
                    <span>✓</span>
                    Full name should be clear.
                </div>

                <div>
                    <span>✓</span>
                    Use a valid email address.
                </div>

                <div>
                    <span>✓</span>
                    Add a clear specialization.
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}