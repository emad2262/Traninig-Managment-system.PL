@model EmployeeIndexVm
    <!-- Main Content -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3 mx-4" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<main class="main-content">
    <div class="container-fluid px-4 py-4">

        <div class="page-header mb-4">
            <div class="row align-items-center">
                <div class="col">
                    <h1 class="page-title">Employees</h1>
                    <p class="page-subtitle">Manage employees, progress, and enrollments</p>
                </div>
            </div>
        </div>

        <form asp-action="Index" method="get" class="toolbar-card mb-4">
            <div class="row g-3 align-items-center">

                <div class="col-12 col-md-4">
                    <div class="search-wrapper position-relative">
                        <i class="bi bi-search search-icon position-absolute top-50 translate-middle-y ms-3 text-muted"></i>
                        <input type="text" name="Name" value="@Model.Name" class="form-control ps-5" placeholder="Search employees..." />
                    </div>
                </div>

                <div class="col-12 col-md-2 col-lg-4 text-md-end">
                    <button type="submit" class="btn btn-primary-gradient w-100 w-md-auto me-2">
                        <i class="bi bi-funnel me-2"></i>Filter
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary w-100 w-md-auto">
                        Reset
                    </a>
                </div>

                <div class="col-auto ms-auto">
                    <a asp-action="Create" asp-controller="Employee" asp-area="Company" class="btn btn-primary-gradient">
                        <i class="bi bi-plus-lg me-2"></i> Add Employee
                    </a>
                </div>
            </div>
        </form>

        <div class="content-card bg-white shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">

                @if (!Model.Employees.Any())
                {
                    <div class="text-center p-5 text-muted">
                        <i class="bi bi-people-fill fs-1 d-block mb-3"></i>
                        <h5>No employees found.</h5>
                        <p>Click "Add Employee" to get started.</p>
                    </div>
                }
                else
                {
                    <table class="table table-custom table-hover align-middle mb-0">
                        <thead class="bg-light text-muted">
                            <tr>
                                <th class="ps-4">Employee</th>
                                <th>Job Title</th>
                                <th>Overall Progress</th>
                                <th>Status</th>
                                <th>courses</th>
                                <th>Assign</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Employees)
                            {
                                var formattedName = item.Name.Replace(" ", "+");
                                var avatarUrl = $"https://ui-avatars.com/api/?name={formattedName}&background=random&color=fff";

                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@avatarUrl" alt="@item.Name" class="rounded-circle shadow-sm" style="width: 40px; height: 40px; object-fit: cover;">
                                            <div>
                                                <a href="/Company/Employee/Details/@item.Id"> 
                                                    <div class="fw-bold text-dark mb-0">@item.Name</div>
                                                </a>
                                                <div class="text-muted small">@item.Email</div>
                                            </div>
                                        </div>
                                    </td>

                                    <td><span class="text-secondary fw-medium">@(string.IsNullOrEmpty(item.JobTitle) ? "N/A" : item.JobTitle)</span></td>

                                    @{
                                        var progress = item.Points; // أو أي معادلة حسب نظام النقط بتاعك
                                        var progressClass = progress < 25 ? "bg-danger" : progress < 50 ? "bg-warning" : progress < 80 ? "bg-primary" : "bg-success";
                                        var progressText = progress >= 100 ? "Completed" : $"{progress}%";
                                    }
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 6px; min-width: 80px;">
                                                <div class="progress-bar @progressClass" role="progressbar" style="width: @(progress > 100 ? 100 : progress)%;"></div>
                                            </div>
                                            <span class="small fw-bold text-muted" style="width: 35px;">@progressText</span>
                                        </div>
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 border border-success border-opacity-25 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i>Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1 border border-secondary border-opacity-25 rounded-pill"><i class="bi bi-dash-circle-fill me-1"></i>Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-light btn-sm text-primary me-1 " data-bs-toggle="collapse" title="View Enrolled Courses">
                                            <i class=""></i> <span class="ms-1 fw-bold">@item.CoursesCount</span>
                                        </button>

                                    </td>

                                    <td>
                                        <a asp-action="AssignCourse" asp-route-employeeId="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="bi bi-book me-1"></i> Assign
                                        </a>
                                    </td>

                                    <td class="text-end pe-4">
                                      

                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-light btn-sm text-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>

                                
                            }
                        </tbody>
                    </table>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white border-top py-3">
                    <div class="d-flex justify-content-center">
                        <ul class="pagination pagination-sm mb-0">
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link shadow-none" href="@Url.Action("Index", new { page = i, Name = Model.Name })">@i</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    </div>
</main>