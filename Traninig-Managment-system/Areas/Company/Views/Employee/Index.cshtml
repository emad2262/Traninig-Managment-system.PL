@model EmployeeIndexVm

@{
    ViewData["Title"] = "Employees";

    var totalEmployees = Model.Employees.Count();
    var activeEmployees = Model.Employees.Count(e => e.IsActive);
    var inactiveEmployees = totalEmployees - activeEmployees;
    var totalAssignments = Model.Employees.Sum(e => e.CoursesCount);
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3 mx-4" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3 mx-4" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="employee-admin-shell">
    <section class="employee-admin-hero">
        <div>
            <span class="employee-admin-kicker">Company Area</span>
            <h1>Employees Directory</h1>
            <p>Manage your team, review learning activity, assign courses, and remove employees safely from one workspace.</p>
        </div>

        <div class="employee-admin-hero-actions">
            <a asp-action="Create" asp-controller="Employee" asp-area="Company" class="btn btn-primary-gradient">
                <i class="bi bi-plus-lg me-2"></i>Add Employee
            </a>
        </div>
    </section>

    <section class="employee-overview-grid">
        <article class="employee-overview-card">
            <span>Total Employees</span>
            <strong>@totalEmployees</strong>
        </article>
        <article class="employee-overview-card">
            <span>Active Accounts</span>
            <strong>@activeEmployees</strong>
        </article>
        <article class="employee-overview-card">
            <span>Inactive Accounts</span>
            <strong>@inactiveEmployees</strong>
        </article>
        <article class="employee-overview-card">
            <span>Total Assignments</span>
            <strong>@totalAssignments</strong>
        </article>
    </section>

    <form asp-action="Index" method="get" class="employee-directory-toolbar">
        <div class="employee-directory-search">
            <i class="bi bi-search"></i>
            <input type="text" name="Name" value="@Model.Name" class="form-control" placeholder="Search by employee name..." />
        </div>

        <div class="employee-directory-toolbar-actions">
            <button type="submit" class="btn btn-primary-gradient">
                <i class="bi bi-funnel me-2"></i>Filter
            </button>
            <a asp-action="Index" class="btn btn-course-light">Reset</a>
        </div>
    </form>

    @if (!Model.Employees.Any())
    {
        <section class="employee-directory-empty">
            <i class="bi bi-people"></i>
            <h2>No employees found</h2>
            <p>Add a new employee or adjust the search filter to see matching results.</p>
        </section>
    }
    else
    {
        <section class="employee-directory-grid">
            @foreach (var employee in Model.Employees.OrderByDescending(e => e.IsActive).ThenBy(e => e.Name))
            {
                var progressValue = Math.Max(0, Math.Min(100, employee.Points));

                <article class="employee-directory-card">
                    <div class="employee-directory-card-top">
                        <div class="employee-directory-avatar">
                            @GetInitials(employee.Name)
                        </div>

                        <div class="employee-directory-copy">
                            <div class="employee-directory-status-row">
                                <span class="course-status @(employee.IsActive ? "published" : "draft")">
                                    @(employee.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>
                            <h2>@employee.Name</h2>
                            <p>@employee.Email</p>
                        </div>
                    </div>

                    <div class="employee-directory-tags">
                        <span><i class="bi bi-briefcase"></i> @(string.IsNullOrWhiteSpace(employee.JobTitle) ? "No job title" : employee.JobTitle)</span>
                        <span><i class="bi bi-journal-check"></i> @employee.CoursesCount course(s)</span>
                        <span><i class="bi bi-stars"></i> @employee.Points point(s)</span>
                    </div>

                    <div class="employee-directory-progress">
                        <div class="employee-directory-progress-head">
                            <strong>Learning Score</strong>
                            <span>@progressValue.ToString("0.#")%</span>
                        </div>
                        <div class="progress">
                            <div class="progress-bar" role="progressbar" style="width:@progressValue%;"></div>
                        </div>
                    </div>

                    <div class="employee-directory-actions">
                        <a asp-action="Details" asp-route-id="@employee.Id" class="btn btn-course-light">
                            <i class="bi bi-eye"></i>
                            <span>Details</span>
                        </a>

                        <a asp-action="AssignCourse" asp-route-employeeId="@employee.Id" class="btn btn-primary-gradient">
                            <i class="bi bi-grid-1x2"></i>
                            <span>Manage Courses</span>
                        </a>

                        <form asp-action="Delete" method="post" class="m-0" onsubmit="return confirm('Delete this employee account and all related progress?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@employee.Id" />
                            <button type="submit" class="btn btn-course-danger">
                                <i class="bi bi-trash"></i>
                                <span>Delete</span>
                            </button>
                        </form>
                    </div>
                </article>
            }
        </section>
    }
</div>

@functions {
    private string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "EM";

        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0].Substring(0, 1).ToUpper();

        return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }
}
