@model AssignCourseVm

@{
    ViewData["Title"] = "Manage Employee Courses";

    var totalCourses = Model.Courses.Count();
    var assignedCourses = Model.Courses.Count(c => c.IsAssigned);
    var publishedCourses = Model.Courses.Count(c => c.IsPublished);
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="assignment-management-page">
    <section class="assignment-management-hero">
        <div class="assignment-management-copy">
            <a asp-action="Details" asp-route-id="@Model.EmployeeId" class="btn btn-course-light">
                <i class="bi bi-arrow-left"></i>
                <span>Back to Employee</span>
            </a>

            <span class="employee-page-badge mt-3">Course Management</span>
            <h1>@Model.EmployeeName</h1>
            <p>@Model.EmployeeEmail</p>

            <div class="assignment-management-tags">
                <span><i class="bi bi-briefcase"></i> @(string.IsNullOrWhiteSpace(Model.JobTitle) ? "No job title" : Model.JobTitle)</span>
                <span><i class="bi bi-check2-circle"></i> @assignedCourses assigned</span>
                <span><i class="bi bi-journal-richtext"></i> @totalCourses visible course(s)</span>
            </div>
        </div>
    </section>

    <section class="employee-detail-stats-grid">
        <article class="employee-stat-card">
            <span>Visible Courses</span>
            <strong>@totalCourses</strong>
        </article>
        <article class="employee-stat-card">
            <span>Assigned = True</span>
            <strong>@assignedCourses</strong>
        </article>
        <article class="employee-stat-card">
            <span>Published</span>
            <strong>@publishedCourses</strong>
        </article>
        <article class="employee-stat-card">
            <span>Draft</span>
            <strong>@(totalCourses - publishedCourses)</strong>
        </article>
    </section>

    <form asp-action="AssignCourse" method="get" class="employee-directory-toolbar">
        <input type="hidden" name="employeeId" value="@Model.EmployeeId" />

        <div class="employee-directory-search">
            <i class="bi bi-search"></i>
            <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by course title, description, or category..." />
        </div>

        <div class="assignment-toolbar-select">
            <select name="categoryId" class="form-select">
                <option value="">All Categories</option>
                @foreach (var cat in Model.Categories)
                {
                    if (Model.CategoryId == cat.Id)
                    {
                        <option value="@cat.Id" selected>@cat.Name</option>
                    }
                    else
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                }
            </select>
        </div>

        <div class="employee-directory-toolbar-actions">
            <button type="submit" class="btn btn-primary-gradient">
                <i class="bi bi-funnel me-2"></i>Apply
            </button>
            <a asp-action="AssignCourse" asp-route-employeeId="@Model.EmployeeId" class="btn btn-course-light">Reset</a>
        </div>
    </form>

    @if (!Model.Courses.Any())
    {
        <section class="employee-course-empty">
            <i class="bi bi-journal-x"></i>
            <h3>No courses match this filter</h3>
            <p>Try another search or category filter to see the employee course catalog.</p>
        </section>
    }
    else
    {
        <section class="employee-course-grid">
            @foreach (var course in Model.Courses)
            {
                var progressValue = Math.Max(0, Math.Min(100, course.Progress));
                var statusText = !course.IsAssigned
                    ? "Not Assigned"
                    : course.Status == CourseStatus.Completed
                        ? "Completed"
                        : course.Status == CourseStatus.InProgress
                            ? "In Progress"
                            : "Not Started";

                <article class="employee-course-manage-card">
                    <div class="employee-course-topline">
                        <span class="course-status @(course.IsPublished ? "published" : "draft")">
                            @(course.IsPublished ? "Published" : "Draft")
                        </span>
                        <span class="employee-assignment-flag @(course.IsAssigned ? "true-state" : "false-state")">
                            Assigned = @(course.IsAssigned ? "True" : "False")
                        </span>
                    </div>

                    <div class="employee-course-head">
                        <div>
                            <span class="employee-course-category">@(string.IsNullOrWhiteSpace(course.CategoryName) ? "Training Course" : course.CategoryName)</span>
                            <h3>@course.CourseName</h3>
                            <p>@(string.IsNullOrWhiteSpace(course.Description) ? "No description available for this course yet." : course.Description)</p>
                        </div>
                    </div>

                    <div class="employee-course-meta-grid">
                        <span><i class="bi bi-person-badge"></i> @(string.IsNullOrWhiteSpace(course.InstructorName) ? "No Instructor" : course.InstructorName)</span>
                        <span><i class="bi bi-clock-history"></i> @course.DurationInHours hour(s)</span>
                        <span><i class="bi bi-calendar-event"></i> @(course.StartDate?.ToString("dd MMM yyyy") ?? "No start date")</span>
                        <span><i class="bi bi-calendar-check"></i> @(course.EndDate?.ToString("dd MMM yyyy") ?? "No end date")</span>
                    </div>

                    <div class="employee-course-progress">
                        <div class="employee-course-progress-head">
                            <strong>@statusText</strong>
                            <span>@(course.IsAssigned ? $"{progressValue:0.#}%" : "0%")</span>
                        </div>
                        <div class="progress">
                            <div class="progress-bar" role="progressbar" style="width:@(course.IsAssigned ? progressValue : 0)%;"></div>
                        </div>
                    </div>

                    <div class="employee-course-actions">
                        <a asp-area="Company" asp-controller="Course" asp-action="Details" asp-route-id="@course.CourseId" class="btn btn-course-light">
                            <i class="bi bi-eye"></i>
                            <span>View Course</span>
                        </a>

                        @if (course.IsAssigned)
                        {
                            <form asp-area="Company" asp-controller="Employee" asp-action="ToggleCourseAssignment" method="post" class="m-0" onsubmit="return confirm('Remove this assignment and employee progress for the course?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
                                <input type="hidden" name="courseId" value="@course.CourseId" />
                                <input type="hidden" name="isAssigned" value="true" />
                                <input type="hidden" name="search" value="@Model.Search" />
                                <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                                <input type="hidden" name="returnAction" value="AssignCourse" />
                                <button type="submit" class="btn btn-course-warning">
                                    <i class="bi bi-person-dash"></i>
                                    <span>Unassign</span>
                                </button>
                            </form>
                        }
                        else if (course.IsPublished)
                        {
                            <form asp-area="Company" asp-controller="Employee" asp-action="ToggleCourseAssignment" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
                                <input type="hidden" name="courseId" value="@course.CourseId" />
                                <input type="hidden" name="isAssigned" value="false" />
                                <input type="hidden" name="search" value="@Model.Search" />
                                <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                                <input type="hidden" name="returnAction" value="AssignCourse" />
                                <button type="submit" class="btn btn-course-success">
                                    <i class="bi bi-person-plus"></i>
                                    <span>Assign</span>
                                </button>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="btn btn-course-muted" disabled>
                                <i class="bi bi-lock"></i>
                                <span>Draft Course</span>
                            </button>
                        }
                    </div>
                </article>
            }
        </section>
    }
</div>
