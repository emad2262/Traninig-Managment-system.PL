
@model CompanyDisplayVm


@{
    ViewData["Title"] = "Dashboard";

    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";

    

    

    var daysLeft = Math.Max(0, (Model.SubscriptionEndDate.Date - DateTime.Now.Date).Days);
    var subscriptionIsUrgent = daysLeft <= 7;
    var subscriptionNeedsNotice = daysLeft <= 30;
}

<div class="era-dash">

    <!-- ========================= HERO ========================= -->
    <section class="era-hero era-rise" style="--delay:.05s">

        <div class="era-hero__top">
            <span class="era-kicker">ERA &middot; @Model.CompanyName</span>
            <span class="era-stamp">
                <i class="bi bi-calendar3"></i> @DateTime.Now.ToString("ddd, dd MMM yyyy")
            </span>
        </div>

        <h1 class="era-hero__greeting">@greeting</h1>
        <p class="era-hero__sub">Here is where your training programs stand right now.</p>

        @* @if (assigned == 0)
        {
            <div class="era-hero__empty">
                <p>No courses are assigned yet. Assign your first course to start tracking completion.</p>
                <a class="era-jump" asp-area="Company" asp-controller="Course" asp-action="Index">
                    <span class="era-jump__icon"><i class="bi bi-plus-lg"></i></span>
                    <span class="era-jump__text">
                        <span class="era-jump__title">Assign a course</span>
                        <span class="era-jump__meta">@Model.CourseCount available</span>
                    </span>
                    <i class="bi bi-arrow-right era-jump__go"></i>
                </a>
            </div>
        }
        else
        {
            <div class="era-hero__grid">

                <div class="era-hero__lead">
                    <p class="era-hero__label">Training completion</p>
                    <p class="era-hero__figure">@completedPercent<span>%</span></p>
                    <p class="era-hero__note">@completed of @assigned assigned courses finished</p>
                </div>

                <div class="era-ribbon">
                    <div class="era-ribbon__bar">
                        <span class="era-ribbon__seg era-ribbon__seg--done" style="--w:@(completedPercent)%"></span>
                        <span class="era-ribbon__seg era-ribbon__seg--active" style="--w:@(inProgressPercent)%"></span>
                        <span class="era-ribbon__seg era-ribbon__seg--idle" style="--w:@(notStartedPercent)%"></span>
                    </div>
                    <div class="era-ribbon__scale">
                        <span>0</span><span>25</span><span>50</span><span>75</span><span>100</span>
                    </div>
                    <ul class="era-legend">
                        <li><span class="era-swatch era-swatch--done"></span> Completed <b>@completed</b></li>
                        <li><span class="era-swatch era-swatch--active"></span> In progress <b>@inProgress</b></li>
                        <li><span class="era-swatch era-swatch--idle"></span> Not started <b>@notStarted</b></li>
                    </ul>
                </div>

            </div>
        } *@

        <div class="era-figures">
            <div class="era-figure">
                <span class="era-figure__value">@Model.EmployeeCount</span>
                <span class="era-figure__label">Employees</span>
            </div>
            <div class="era-figure">
                <span class="era-figure__value">@Model.CourseCount</span>
                <span class="era-figure__label">Courses</span>
            </div>
            <div class="era-figure">
                <span class="era-figure__value">@Model.InstructorCount</span>
                <span class="era-figure__label">Instructors</span>
            </div>
            
        </div>

    </section>

    <!-- ==================== SUBSCRIPTION ALERT ==================== -->
    @if (subscriptionNeedsNotice)
    {
        <a class="era-alert @(subscriptionIsUrgent ? "era-alert--danger" : "era-alert--warn") era-rise"
           style="--delay:.15s" asp-area="Company" asp-controller="Subscription" asp-action="Index">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>
                Your <strong>@Model.PlanName</strong> plan renews in <strong>@daysLeft days</strong>
                &mdash; on @Model.SubscriptionEndDate.ToString("dd MMM yyyy").
            </span>
            <span class="era-alert__cta">Renew <i class="bi bi-arrow-right"></i></span>
        </a>
    }

    <!-- ==================== CATALOG + ATTENTION ==================== -->
    <section class="era-section era-rise" style="--delay:.2s">
        <div class="era-section__head">
            <h2 class="era-section__title">Your workspace</h2>
            <span class="era-section__rule"></span>
        </div>

        <div class="row g-3">

            <div class="col-lg-7">
                <div class="era-panel">
                    <div class="era-panel__head">
                        <h3 class="era-panel__title">Catalog</h3>
                        <span class="era-panel__meta">Updated @DateTime.Now.ToString("HH:mm")</span>
                    </div>
                    <ul class="era-ledger">
                        <li>
                            <span class="era-ledger__label">Published courses</span>
                            <span class="era-ledger__hint">visible to employees</span>
                            <span class="era-ledger__lead"></span>
                            <span class="era-ledger__value">@Model.PublishedCourseCount</span>
                        </li>
                      
                        <li>
                            <span class="era-ledger__label">Categories</span>
                            <span class="era-ledger__hint">catalog structure</span>
                            <span class="era-ledger__lead"></span>
                            <span class="era-ledger__value">@Model.CategoryCount</span>
                        </li>
                        <li>
                            <span class="era-ledger__label">Instructors</span>
                            <span class="era-ledger__hint">assigned to courses</span>
                            <span class="era-ledger__lead"></span>
                            <span class="era-ledger__value">@Model.InstructorCount</span>
                        </li>
                        
                    </ul>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="era-panel">
                    <div class="era-panel__head">
                        <h3 class="era-panel__title">Needs your attention</h3>
                    </div>

                   
                            @if (subscriptionNeedsNotice)
                            {
                                <li>
                                    <a asp-area="Company" asp-controller="Subscription" asp-action="Index">
                                        <span class="era-dot @(subscriptionIsUrgent ? "era-dot--danger" : "era-dot--warn")"></span>
                                        <span class="era-attention__text">
                                            <span class="era-attention__title">Subscription renews in @daysLeft days</span>
                                            <span class="era-attention__desc">Renew to keep your workspace active</span>
                                        </span>
                                        <i class="bi bi-chevron-right era-attention__go"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

        </div>
    </section>

    <!-- ========================= JUMP BACK IN ========================= -->
    <section class="era-section era-rise" style="--delay:.25s">
        <div class="era-section__head">
            <h2 class="era-section__title">Jump back in</h2>
            <span class="era-section__rule"></span>
        </div>

        <div class="row g-3">
            <div class="col-xl-3 col-md-6">
                <a class="era-jump" asp-area="Company" asp-controller="Employee" asp-action="Index">
                    <span class="era-jump__icon"><i class="bi bi-people"></i></span>
                    <span class="era-jump__text">
                        <span class="era-jump__title">Employees</span>
                        <span class="era-jump__meta">@Model.EmployeeCount enrolled</span>
                    </span>
                    <i class="bi bi-arrow-right era-jump__go"></i>
                </a>
            </div>
            <div class="col-xl-3 col-md-6">
                <a class="era-jump" asp-area="Company" asp-controller="Course" asp-action="Index">
                    <span class="era-jump__icon"><i class="bi bi-journal-bookmark"></i></span>
                    <span class="era-jump__text">
                        <span class="era-jump__title">Courses</span>
                        <span class="era-jump__meta">@Model.PublishedCourseCount published</span>
                    </span>
                    <i class="bi bi-arrow-right era-jump__go"></i>
                </a>
            </div>
            <div class="col-xl-3 col-md-6">
                <a class="era-jump" asp-area="Company" asp-controller="Category" asp-action="Index">
                    <span class="era-jump__icon"><i class="bi bi-diagram-3"></i></span>
                    <span class="era-jump__text">
                        <span class="era-jump__title">Categories</span>
                        <span class="era-jump__meta">@Model.CategoryCount in catalog</span>
                    </span>
                    <i class="bi bi-arrow-right era-jump__go"></i>
                </a>
            </div>
            <div class="col-xl-3 col-md-6">
                <a class="era-jump" asp-area="Company" asp-controller="Instractor" asp-action="Index">
                    <span class="era-jump__icon"><i class="bi bi-person-workspace"></i></span>
                    <span class="era-jump__text">
                        <span class="era-jump__title">Instructors</span>
                        <span class="era-jump__meta">@Model.InstructorCount active</span>
                    </span>
                    <i class="bi bi-arrow-right era-jump__go"></i>
                </a>
            </div>
        </div>
    </section>


</div>