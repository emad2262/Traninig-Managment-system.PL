@model CompanyDashboardDto

@{
    ViewData["Title"] = "Company Dashboard";

    var companyName = string.IsNullOrWhiteSpace(User.Identity?.Name) ? "Company Admin" : User.Identity!.Name;
    var currentHour = DateTime.Now.Hour;
    var greeting = currentHour < 12 ? "Good morning" : currentHour < 18 ? "Good afternoon" : "Good evening";

    // Sample overview figures used purely to populate the dashboard UI
    var totalEmployees = 128;
    var totalInstructors = 15;
    var totalCategories = 9;
    var totalCourses = 42;
    var activeCourses = 27;
    var completedCourses = 15;
    var certificatesIssued = 63;

    var subscriptionExpiry = DateTime.Now.AddDays(23);
    var daysRemaining = Math.Max(0, (subscriptionExpiry.Date - DateTime.Now.Date).Days);

    string subStatusClass = daysRemaining > 14 ? "status-pill--good" : daysRemaining > 5 ? "status-pill--warning" : "status-pill--critical";
    string subStatusLabel = daysRemaining > 14 ? "Active Plan" : daysRemaining > 5 ? "Expiring Soon" : "Renew Now";

    var activePercent = (int)Math.Round(activeCourses * 100.0 / totalCourses);
    var completedPercent = (int)Math.Round(completedCourses * 100.0 / totalCourses);
    var certificatePercent = (int)Math.Round(certificatesIssued * 100.0 / totalEmployees);
}

<div class="company-dashboard">

    <!-- ===================== DASHBOARD HEADER ===================== -->
    <header class="dash-header fade-up" style="--delay:0.05s">
        <div class="dash-header__intro">
            <span class="dash-eyebrow">Company Workspace</span>
            <h1 class="dash-title">@greeting, @companyName</h1>
            <p class="dash-subtitle">Here's what's happening across your training programs today.</p>
        </div>
        <div class="dash-header__meta">
            <span class="dash-date-badge"><i class="bi bi-calendar3"></i> @DateTime.Now.ToString("dddd, MMM dd yyyy")</span>
        </div>
    </header>

    <!-- ===================== QUICK NAVIGATION ===================== -->
    <nav class="dash-quicknav fade-up" style="--delay:0.1s" aria-label="Dashboard quick navigation">
        <a class="quicknav-link" asp-area="Company" asp-controller="Employee" asp-action="Index">
            <span class="quicknav-icon"><i class="bi bi-people-fill"></i></span> Employee
        </a>
        <a class="quicknav-link" asp-area="Company" asp-controller="Course" asp-action="Index">
            <span class="quicknav-icon"><i class="bi bi-collection-play-fill"></i></span> Course
        </a>
        <a class="quicknav-link" asp-area="Company" asp-controller="Category" asp-action="Index">
            <span class="quicknav-icon"><i class="bi bi-grid-3x3-gap-fill"></i></span> Category
        </a>
        <a class="quicknav-link" asp-area="Company" asp-controller="Instractor" asp-action="Index">
            <span class="quicknav-icon"><i class="bi bi-person-video3"></i></span> Instructor
        </a>
    </nav>

    <!-- ===================== STATISTICS CARDS ===================== -->
    <section class="dash-section">
        <div class="row g-4">

            <!-- Total Employees -->
            <div class="col-xl-3 col-md-6">
                <div class="stat-card fade-up" style="--delay:0.15s">
                    <div class="stat-icon stat-icon--indigo"><i class="bi bi-people-fill"></i></div>
                    <div class="stat-body">
                        <span class="stat-value">@Model.EmployeeCount</span>
                        <span class="stat-label">Total Employees</span>
                        <span class="stat-caption">Across all departments</span>
                    </div>
                </div>
            </div>

            <!-- Total Instructors -->
            <div class="col-xl-3 col-md-6">
                <div class="stat-card fade-up" style="--delay:0.2s">
                    <div class="stat-icon stat-icon--amber"><i class="bi bi-person-video3"></i></div>
                    <div class="stat-body">
                        <span class="stat-value">@totalInstructors</span>
                        <span class="stat-label">Total Instructors</span>
                        <span class="stat-caption">Currently teaching</span>
                    </div>
                </div>
            </div>

            <!-- Total Categories -->
            <div class="col-xl-3 col-md-6">
                <div class="stat-card fade-up" style="--delay:0.25s">
                    <div class="stat-icon stat-icon--violet"><i class="bi bi-grid-3x3-gap-fill"></i></div>
                    <div class="stat-body">
                        <span class="stat-value">@totalCategories</span>
                        <span class="stat-label">Total Categories</span>
                        <span class="stat-caption">Training topics available</span>
                    </div>
                </div>
            </div>

            <!-- Total Courses -->
            <div class="col-xl-3 col-md-6">
                <div class="stat-card fade-up" style="--delay:0.3s">
                    <div class="stat-icon stat-icon--teal"><i class="bi bi-collection-play-fill"></i></div>
                    <div class="stat-body">
                        <span class="stat-value">@totalCourses</span>
                        <span class="stat-label">Total Courses</span>
                        <span class="stat-caption">Published in your catalog</span>
                    </div>
                </div>
            </div>

            <!-- Active Courses -->
            <div class="col-xl-3 col-md-6">
                <div class="stat-card fade-up" style="--delay:0.35s">
                    <div class="stat-icon stat-icon--sky"><i class="bi bi-broadcast-pin"></i></div>
                    <div class="stat-body">
                        <span class="stat-value">@activeCourses</span>
                        <span class="stat-label">Active Courses</span>
                        <span class="stat-caption">Currently in progress</span>
                    </div>
                </div>
            </div>

            <!-- Completed Courses -->
            <div class="col-xl-3 col-md-6">
                <div class="stat-card fade-up" style="--delay:0.4s">
                    <div class="stat-icon stat-icon--emerald"><i class="bi bi-patch-check-fill"></i></div>
                    <div class="stat-body">
                        <span class="stat-value">@completedCourses</span>
                        <span class="stat-label">Completed Courses</span>
                        <span class="stat-caption">Finished by employees</span>
                    </div>
                </div>
            </div>

            <!-- Certificates Issued -->
            <div class="col-xl-3 col-md-6">
                <div class="stat-card fade-up" style="--delay:0.45s">
                    <div class="stat-icon stat-icon--rose"><i class="bi bi-award-fill"></i></div>
                    <div class="stat-body">
                        <span class="stat-value">@certificatesIssued</span>
                        <span class="stat-label">Certificates Issued</span>
                        <span class="stat-caption">Awarded to employees</span>
                    </div>
                </div>
            </div>

            <!-- Subscription Expiration -->
            <div class="col-xl-3 col-md-6">
                <div class="stat-card stat-card--subscription fade-up" style="--delay:0.5s">
                    <div class="stat-icon stat-icon--slate"><i class="bi bi-calendar-check-fill"></i></div>
                    <div class="stat-body">
                        <span class="stat-value">@daysRemaining <small>days left</small></span>
                        <span class="stat-label">Subscription Expiration</span>
                        <span class="stat-caption">Expires @subscriptionExpiry.ToString("MMM dd, yyyy")</span>
                    </div>
                    <span class="status-pill @subStatusClass">@subStatusLabel</span>
                </div>
            </div>

        </div>
    </section>

    <!-- ===================== OVERVIEW + QUICK ACTIONS ===================== -->
    <section class="dash-section">
        <div class="row g-4">

            <!-- Training Progress Overview -->
            <div class="col-lg-7">
                <div class="panel-card fade-up" style="--delay:0.55s">
                    <div class="panel-header">
                        <h2 class="panel-title"><i class="bi bi-bar-chart-line-fill"></i> Training Progress Overview</h2>
                        <p class="panel-subtitle">Snapshot of course activity across your organization</p>
                    </div>

                    <div class="progress-row">
                        <div class="progress-row__label">
                            <span>Active Courses</span>
                            <span>@activeCourses / @totalCourses</span>
                        </div>
                        <div class="progress-track">
                            <div class="progress-fill progress-fill--sky" style="width:@(activePercent)%"></div>
                        </div>
                    </div>

                    <div class="progress-row">
                        <div class="progress-row__label">
                            <span>Completed Courses</span>
                            <span>@completedCourses / @totalCourses</span>
                        </div>
                        <div class="progress-track">
                            <div class="progress-fill progress-fill--emerald" style="width:@(completedPercent)%"></div>
                        </div>
                    </div>

                    <div class="progress-row">
                        <div class="progress-row__label">
                            <span>Certificates Issued</span>
                            <span>@certificatesIssued / @totalEmployees</span>
                        </div>
                        <div class="progress-track">
                            <div class="progress-fill progress-fill--rose" style="width:@(certificatePercent)%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="col-lg-5">
                <div class="panel-card fade-up" style="--delay:0.6s">
                    <div class="panel-header">
                        <h2 class="panel-title"><i class="bi bi-lightning-charge-fill"></i> Quick Actions</h2>
                        <p class="panel-subtitle">Jump right into managing your workspace</p>
                    </div>

                    <div class="quick-actions-list">
                        <a class="quick-action-item" asp-area="Company" asp-controller="Employee" asp-action="Index">
                            <span class="qa-icon qa-icon--indigo"><i class="bi bi-people-fill"></i></span>
                            <span class="qa-text">
                                <span class="qa-title">Manage Employees</span>
                                <span class="qa-desc">Onboard and track staff</span>
                            </span>
                            <i class="bi bi-chevron-right qa-arrow"></i>
                        </a>

                        <a class="quick-action-item" asp-area="Company" asp-controller="Course" asp-action="Index">
                            <span class="qa-icon qa-icon--teal"><i class="bi bi-collection-play-fill"></i></span>
                            <span class="qa-text">
                                <span class="qa-title">Manage Courses</span>
                                <span class="qa-desc">Publish and organize content</span>
                            </span>
                            <i class="bi bi-chevron-right qa-arrow"></i>
                        </a>

                        <a class="quick-action-item" asp-area="Company" asp-controller="Category" asp-action="Index">
                            <span class="qa-icon qa-icon--violet"><i class="bi bi-grid-3x3-gap-fill"></i></span>
                            <span class="qa-text">
                                <span class="qa-title">Manage Categories</span>
                                <span class="qa-desc">Organize your catalog</span>
                            </span>
                            <i class="bi bi-chevron-right qa-arrow"></i>
                        </a>

                        <a class="quick-action-item" asp-area="Company" asp-controller="Instractor" asp-action="Index">
                            <span class="qa-icon qa-icon--amber"><i class="bi bi-person-video3"></i></span>
                            <span class="qa-text">
                                <span class="qa-title">Manage Instructors</span>
                                <span class="qa-desc">Review and assign trainers</span>
                            </span>
                            <i class="bi bi-chevron-right qa-arrow"></i>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- ===================== FOOTER NOTE ===================== -->
    <footer class="dashboard-footer fade-up" style="--delay:0.65s">
        <span>ERA Company Workspace</span>
        <span class="dot-sep">&bull;</span>
        <span>&copy; @DateTime.Now.Year All rights reserved</span>
    </footer>

</div>
