@* @using Traninig_Managment_system.View_Model.Company.Company_Category
@model CategoryDetailsVm



<div class="category-manage-page">
    <section class="category-details-hero">
        <div>
            <a asp-action="Index" class="btn btn-category-light mb-3">
                <i class="bi bi-arrow-left"></i><span>رجوع للأقسام</span>
            </a>
            <span class="category-kicker">Category Details</span>
            <h1>@Model.Name</h1>
            <p>كل الكورسات التابعة للقسم، مع حالة النشر والمدة والمدرب المسؤول.</p>
        </div>
        <div class="category-details-actions">
            <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-category-light">
                <i class="bi bi-pencil"></i><span>تعديل القسم</span>
            </a>
            <a asp-area="Company" asp-controller="Course" asp-action="Create" asp-route-categoryId="@Model.CategoryId" class="btn btn-category-primary">
                <i class="bi bi-plus-lg"></i><span>إضافة كورس</span>
            </a>
        </div>
    </section>

    <section class="category-summary-grid">
        <div class="category-summary-card">
            <span>كل الكورسات</span>
            <strong>@Model.TotalCourse</strong>
        </div>
       
       
    </section>

    @if (!Model.Courses.Any())
    {
        <div class="category-empty-state">
            <div class="category-empty-icon"><i class="bi bi-journal-plus"></i></div>
            <h2>لا توجد كورسات داخل هذا القسم</h2>
            <p>ابدأ بإضافة أول كورس للقسم الحالي.</p>
            <a asp-area="Company" asp-controller="Course" asp-action="Create" asp-route-categoryId="@Model.Id" class="btn btn-category-primary">إضافة أول كورس</a>
        </div>
    }
    else
    {
        <div class="category-course-grid">
            @foreach (var course in Model.Courses)
            {
                <article class="category-course-card">
                    <a asp-area="Company" asp-controller="Course" asp-action="Details" asp-route-id="@course.Id" asp-route-categoryId="@Model.Id" class="category-course-thumb">
                        @if (!string.IsNullOrWhiteSpace(course.Logo))
                        {
                            <img src="@course.Logo" alt="@course.Title" />
                        }
                        else
                        {
                            <div class="category-course-placeholder">
                                <i class="bi bi-journal-bookmark"></i>
                            </div>
                        }
                        <span class="category-course-status @(course.IsPublished ? "published" : "draft")">
                            @(course.IsPublished ? "منشور" : "مسودة")
                        </span>
                    </a>

                    <div class="category-course-body">
                        <div class="category-card-label">@course.DurationInHours ساعة</div>
                        <h2>@course.Title</h2>
                        <p>@(string.IsNullOrWhiteSpace(course.Description) ? "لا يوجد وصف للكورس." : course.Description)</p>

                        <div class="category-course-meta">
                            <span><i class="bi bi-person-badge"></i>@(string.IsNullOrWhiteSpace(course.InstructorName) ? "بدون مدرب" : course.InstructorName)</span>
                            <span><i class="bi bi-calendar-event"></i>@course.StartDate.ToString("dd MMM yyyy")</span>
                            <span><i class="bi bi-calendar-check"></i>@course.EndDate.ToString("dd MMM yyyy")</span>
                        </div>
                    </div>

                    <div class="category-card-actions">
                        <a asp-area="Company" asp-controller="Course" asp-action="Details" asp-route-id="@course.Id" asp-route-categoryId="@Model.Id" class="btn btn-category-light btn-sm">
                            <i class="bi bi-eye"></i><span>تفاصيل</span>
                        </a>
                        <a asp-area="Company" asp-controller="Course" asp-action="Edit" asp-route-id="@course.Id" asp-route-categoryId="@Model.Id" class="btn btn-category-icon btn-sm" title="تعديل">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </div>
                </article>
            }
        </div>
    }
</div> *@
