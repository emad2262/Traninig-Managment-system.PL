
@model EditCategoryVm

@{
    ViewData["Title"] = "تعديل قسم";
}

<div class="category-manage-page">
    <div class="category-form-header">
        <a asp-action="Index" class="btn btn-category-light">
            <i class="bi bi-arrow-left"></i><span>رجوع</span>
        </a>
        <div>
            <span class="category-kicker">Edit Category</span>
            <h1>تعديل بيانات القسم</h1>
            <p>غيّر اسم القسم بدون التأثير على الكورسات الموجودة بداخله.</p>
        </div>
    </div>

    <div class="category-form-layout">
        <form asp-action="Edit" method="post" class="category-form-card">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <label asp-for="Name" class="form-label">اسم القسم</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="validation-toast"></span>

            <div class="category-form-actions">
                <a asp-action="Index" class="btn btn-category-light">إلغاء</a>
                <button type="submit" class="btn btn-category-primary">
                    <i class="bi bi-check2-circle"></i><span>حفظ التعديل</span>
                </button>
            </div>
        </form>

        <aside class="category-side-note warning">
            <i class="bi bi-shield-check"></i>
            <h2>تعديل آمن</h2>
            <p>السيستم بيتأكد إن اسم القسم مش مكرر داخل نفس الشركة قبل الحفظ.</p>
        </aside>
    </div>
</div>

@section scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
