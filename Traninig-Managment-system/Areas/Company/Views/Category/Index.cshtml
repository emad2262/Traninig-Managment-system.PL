@using Traninig_Managment_system.View_Model.Company.Company_Category
@model IEnumerable<CategoryDisplayVm>



<div class="category-manage-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success category-alert">
            <i class="bi bi-check-circle"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger category-alert">
            <i class="bi bi-exclamation-triangle"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <section class="category-page-header">
        <div>
            <span class="category-kicker">Training Categories</span>
            <h1>إدارة أقسام التدريب</h1>
            <p>نظم كورسات الشركة في أقسام واضحة، وتابع عدد الكورسات المنشورة والمسودات داخل كل قسم.</p>
        </div>
        <div class="category-header-actions">
            <a asp-action="Create" class="btn btn-category-primary">
                <i class="bi bi-plus-lg"></i>
                <span>إضافة قسم</span>
            </a>
        </div>
    </section>

    <section class="category-summary-grid">
        <div class="category-summary-card">
            <span>الأقسام</span>
            @* <strong>@categories.Count</strong> *@
        </div>
        <div class="category-summary-card">
            <span>كل الكورسات</span>
            <strong>
                @foreach (var item in Model)
                {
                    @item.TotalCourses
                }
            </strong>
        </div>
        <div class="category-summary-card">
            <span>المنشور</span>
            @* <strong>@publishedCourses</strong> *@
        </div>
    </section>

    
    else
    {
        <div class="category-grid">
            @foreach (var category in Model)
            {
                <article class="category-admin-card">
                    <div class="category-card-glow"></div>
                    <div class="category-card-body">
                        <div class="category-card-icon">
                            <i class="bi bi-collection-play"></i>
                        </div>
                        <div class="category-card-copy">
                            <span class="category-card-label">قسم تدريبي</span>
                            <h2>@category.CategoryName</h2>
                        </div>
                    </div>

                    <div class="category-card-stats">
                        <span><strong>@category.TotalCourses</strong> كورس</span>
                     
                    </div>

                    <div class="category-card-actions">
                        <a asp-action="Details" asp-route-id="@category.Id" class="btn btn-category-light btn-sm">
                            <i class="bi bi-eye"></i><span>تفاصيل</span>
                        </a>
                        <a asp-area="Company" asp-controller="Course" asp-action="Index" asp-route-categoryId="@category.Id" class="btn btn-category-light btn-sm">
                            <i class="bi bi-journal-bookmark"></i><span>الكورسات</span>
                        </a>
                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-category-icon btn-sm" title="تعديل">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="Delete" method="post" class="m-0" onsubmit="return confirm('هل تريد حذف هذا القسم؟ لا يمكن حذف القسم لو يحتوي على كورسات.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@category.Id" />
                            <button type="submit" class="btn btn-category-danger btn-sm" title="حذف">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
</div>
